###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_secret_in_production
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://haki_user:haki_password@127.0.0.1:3306/haki_yetu?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Exemple avec un compte Yahoo (celui du dépliant) via SMTP :
# MAILER_DSN=smtp://hakiyetuass%40yahoo.fr:MOT_DE_PASSE_APPLICATION@smtp.mail.yahoo.com:465?encryption=ssl
# Voir README.md > "Configurer l'envoi d'e-mails" pour les détails et alternatives (Gmail, SendGrid, Mailjet...)
MAILER_DSN=smtp://localhost
###< symfony/mailer ###

###> app ###
# Adresse qui reçoit les messages du formulaire de contact (celle du dépliant HAKI YETU)
# CONTACT_RECIPIENT_EMAIL=hakiyetuass@yahoo.fr
CONTACT_RECIPIENT_EMAIL=moiserukabo@gmail.com
###< app ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
