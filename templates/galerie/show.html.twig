{% extends 'base.html.twig' %}

{% block title %}{{ album.titre }} — Galerie HAKI YETU asbl | Album photo{% endblock %}

{% block meta_description %}Album photo {{ album.titre }} — {{ album.description ? album.description|u.truncate(160, '...') : 'Galerie photo de HAKI YETU asbl à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo).' }}{% endblock %}

{% block og_title %}{{ album.titre }} — Galerie HAKI YETU asbl{% endblock %}
{% block og_description %}{{ album.description ? album.description|u.truncate(160, '...') : 'Album photo de HAKI YETU asbl à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo).' }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css"/>
{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
        <a href="{{ path('app_galerie') }}" class="text-sm font-semibold text-brand-700 hover:text-brand-800">← Tous les albums</a>

        <h1 class="mt-3 font-display text-4xl font-semibold text-navy-900">{{ album.titre }}</h1>
        <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-ink-900/60">
            {% if album.date %}<span>{{ album.date|date('d/m/Y') }}</span>{% endif %}
            <span>{{ album.images|length }} photo(s)</span>
        </div>
        {% if album.description %}
            <p class="prose-body mt-4">{{ album.description }}</p>
        {% endif %}

        {% if album.images|length > 0 %}
            <div class="mt-10 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
                {% for image in album.images %}
                    <figure class="overflow-hidden rounded-xl bg-white ring-1 ring-brand-200">
                        <a href="{{ vich_uploader_asset(image, 'imageFile') }}"
                           data-fancybox="gallery"
                           data-caption="{{ image.legende ?: album.titre }}">
                            <img src="{{ vich_uploader_asset(image, 'imageFile')|imagine_filter('medium') }}"
                                 alt="{{ image.legende ?: album.titre }}"
                                 loading="lazy"
                                 class="h-56 w-full object-cover transition duration-300 hover:scale-105">
                        </a>
                        {% if image.legende %}
                            <figcaption class="p-3 text-xs text-ink-900/60">{{ image.legende }}</figcaption>
                        {% endif %}
                    </figure>
                {% endfor %}
            </div>
        {% else %}
            <div class="mt-10 rounded-xl border border-dashed border-brand-200 bg-white p-10 text-center text-ink-900/60">
                Aucune photo dans cet album pour le moment.
            </div>
        {% endif %}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
    <script>
        Fancybox.bind('[data-fancybox="gallery"]', {
            Toolbar: {
                display: {
                    left: ["infobar"],
                    middle: [
                        "zoomIn",
                        "zoomOut",
                        "toggle1to1",
                        "rotateCCW",
                        "rotateCW",
                        "flipX",
                        "flipY",
                    ],
                    right: ["slideshow", "thumbs", "close"],
                },
            },
        });
    </script>
{% endblock %}
