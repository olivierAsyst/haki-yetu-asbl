{% extends 'base.html.twig' %}

{% block title %}Galerie photo — HAKI YETU asbl | Formations, distributions et activités{% endblock %}

{% block meta_description %}Galerie photo de HAKI YETU asbl : formations, distributions, sessions de sensibilisation, activités à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo). Revivez nos actions en images.{% endblock %}

{% block og_title %}Galerie photo — HAKI YETU asbl | Formations, distributions et activités{% endblock %}
{% block og_description %}Galerie photo de HAKI YETU asbl : formations, distributions, sessions de sensibilisation, activités à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo). Revivez nos actions en images.{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="text-center">
            <p class="section-eyebrow">En images</p>
            <h1 class="mt-2 font-display text-5xl font-bold text-navy-900">Galerie photo</h1>
            <p class="prose-body mt-6 max-w-2xl mx-auto text-lg">Formations, distributions, sessions de sensibilisation... revivez nos activités en images, classées par album.</p>
        </div>

        {% if albums.getTotalItemCount() > 0 %}
            <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {% for album in albums %}
                    <a href="{{ path('app_galerie_show', {id: album.id}) }}" class="card-modern group block overflow-hidden">
                        <div class="image-overlay">
                            {% set cover = album.coverImage %}
                            {% if cover %}
                                <img src="{{ vich_uploader_asset(cover, 'imageFile')|imagine_filter('medium') }}" alt="" loading="lazy" class="h-64 w-full object-cover transition duration-500 group-hover:scale-110">
                            {% else %}
                                <div class="flex h-64 w-full items-center justify-center bg-gradient-to-br from-navy-50 to-navy-100 text-navy-600">
                                    <span class="font-display text-lg font-semibold">Album photo</span>
                                </div>
                            {% endif %}
                        </div>
                        <div class="p-6">
                            <h2 class="font-display text-xl font-bold text-navy-900 group-hover:text-brand-700 transition-colors">{{ album.titre }}</h2>
                            {% if album.date %}
                                <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
                                    <span class="opacity-75">📅</span> {{ album.date|date('d/m/Y') }}
                                </p>
                            {% endif %}
                            {% if album.description %}
                                <p class="mt-3 text-sm text-ink-900/70">{{ album.description|u.truncate(90, '…') }}</p>
                            {% endif %}
                            <p class="mt-2 text-sm text-ink-900/60">
                                <span class="opacity-75">📷</span> {{ album.images|length }} photo(s)
                            </p>
                        </div>
                    </a>
                {% endfor %}
            </div>

            <div class="mt-12 flex justify-center">
                {{ knp_pagination_render(albums) }}
            </div>
        {% else %}
            <div class="mt-12 feature-card p-12 text-center text-ink-900/60">
                <span class="text-5xl mb-4 block text-brand-700"><i class="fas fa-folder-open"></i></span>
                <p class="text-lg font-semibold">Aucun album publié pour le moment.</p>
                <p class="text-sm mt-2">Revenez bientôt pour découvrir nos nouvelles photos !</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
