{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi — HAKI YETU asbl | Rejoignez notre équipe{% endblock %}

{% block meta_description %}Découvrez les offres d'emploi de HAKI YETU asbl. Rejoignez notre équipe et contribuez à l'inclusion des personnes vivant avec handicap à Uvira, Fizi et Mwenga.{% endblock %}

{% block og_title %}Offres d'emploi — HAKI YETU asbl{% endblock %}
{% block og_description %}Découvrez les offres d'emploi de HAKI YETU asbl. Rejoignez notre équipe et contribuez à l'inclusion des personnes vivant avec handicap.{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="text-center">
            <p class="section-eyebrow">Carrières</p>
            <h1 class="mt-2 font-display text-5xl font-bold text-navy-900">Offres d'emploi</h1>
            <p class="prose-body mt-6 max-w-2xl mx-auto text-lg">
                Rejoignez notre équipe et contribuez à notre mission d'inclusion des personnes vivant avec handicap.
            </p>
        </div>

        {% if offres.getTotalItemCount() > 0 %}
            <div class="mt-12 space-y-6">
                {% for offre in offres %}
                    <a href="{{ path('app_emplois_show', {slug: offre.slug}) }}" class="card-modern block p-6 transition-all duration-300 hover:shadow-lg">
                        <div class="flex flex-wrap items-start justify-between gap-4">
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-2">
                                    <span class="badge-modern badge-primary text-xs font-semibold uppercase tracking-wide">
                                        {{ offre.typeLabel }}
                                    </span>
                                    {% if offre.datePublication %}
                                        <span class="text-sm text-ink-900/60">
                                            <i class="fas fa-calendar-alt mr-1"></i> {{ offre.datePublication|date('d/m/Y') }}
                                        </span>
                                    {% endif %}
                                    {% if not offre.isAvailable() %}
                                        <span class="badge-modern text-xs font-semibold uppercase tracking-wide bg-red-100 text-red-700">
                                            {{ offre.availabilityStatus }}
                                        </span>
                                    {% endif %}
                                </div>
                                <h2 class="font-display text-2xl font-bold text-navy-900 mb-2">{{ offre.titre }}</h2>
                                <p class="text-sm text-ink-900/70 mb-3">
                                    <i class="fas fa-map-marker-alt mr-2 text-brand-700"></i> {{ offre.lieu }}
                                </p>
                                {% if offre.description %}
                                    <p class="text-sm text-ink-900/60 leading-relaxed">{{ offre.description|u.truncate(150, '…') }}</p>
                                {% endif %}
                            </div>
                            <div class="text-right">
                                {% if offre.fileDeadline %}
                                    <p class="text-sm font-semibold text-brand-700">
                                        <i class="fas fa-clock mr-1"></i> Date limite : {{ offre.fileDeadline|date('d/m/Y') }}
                                    </p>
                                {% endif %}
                                {% if offre.salaireInfo %}
                                    <p class="text-sm text-ink-900/60 mt-1">{{ offre.salaireInfo }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>

            <div class="mt-12 flex justify-center">
                {{ knp_pagination_render(offres) }}
            </div>
        {% else %}
            <div class="mt-12 feature-card p-12 text-center text-ink-900/60">
                <span class="text-5xl mb-4 block text-brand-700"><i class="fas fa-briefcase"></i></span>
                <p class="text-lg font-semibold">Aucune offre d'emploi disponible pour le moment.</p>
                <p class="text-sm mt-2">Revenez bientôt pour découvrir de nouvelles opportunités !</p>
            </div>
        {% endif %}
    </section>
{% endblock %}
