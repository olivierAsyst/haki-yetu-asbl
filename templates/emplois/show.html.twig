{% extends 'base.html.twig' %}

{% block title %}{{ offre.titre }} — HAKI YETU asbl | Offre d'emploi{% endblock %}

{% block meta_description %}{{ offre.description|u.truncate(150, '…') }} — Poste à {{ offre.lieu }} chez HAKI YETU asbl.{% endblock %}

{% block og_title %}{{ offre.titre }} — HAKI YETU asbl{% endblock %}
{% block og_description %}{{ offre.description|u.truncate(150, '…') }} — Poste à {{ offre.lieu }} chez HAKI YETU asbl.{% endblock %}

{% block body %}
    <section class="mx-auto max-w-4xl px-4 py-20 sm:px-6 lg:px-8">
        <div class="mb-6">
            <a href="{{ path('app_emplois') }}" class="text-sm font-semibold text-brand-700 hover:text-brand-800 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i> Retour aux offres
            </a>
        </div>

        <article class="card-modern p-8">
            <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="badge-modern badge-primary text-xs font-semibold uppercase tracking-wide">
                            {{ offre.typeLabel }}
                        </span>
                        {% if not offre.isAvailable() %}
                            <span class="badge-modern text-xs font-semibold uppercase tracking-wide bg-red-100 text-red-700">
                                {{ offre.availabilityStatus }}
                            </span>
                        {% endif %}
                    </div>
                    <h1 class="font-display text-4xl font-bold text-navy-900">{{ offre.titre }}</h1>
                </div>
                <div class="flex gap-2">
                    <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="btn-secondary" title="Partager sur WhatsApp">
                        <i class="fab fa-whatsapp mr-2"></i> Partager
                    </a>
                </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2 mb-8">
                <div class="flex items-center gap-3">
                    <span class="text-2xl text-brand-700"><i class="fas fa-map-marker-alt"></i></span>
                    <div>
                        <p class="text-sm text-ink-900/60">Lieu</p>
                        <p class="font-semibold text-navy-900">{{ offre.lieu }}</p>
                    </div>
                </div>
                {% if offre.datePublication %}
                    <div class="flex items-center gap-3">
                        <span class="text-2xl text-brand-700"><i class="fas fa-calendar-alt"></i></span>
                        <div>
                            <p class="text-sm text-ink-900/60">Date de publication</p>
                            <p class="font-semibold text-navy-900">{{ offre.datePublication|date('d/m/Y') }}</p>
                        </div>
                    </div>
                {% endif %}
                {% if offre.dateExpiration %}
                    <div class="flex items-center gap-3">
                        <span class="text-2xl text-brand-700"><i class="fas fa-calendar-times"></i></span>
                        <div>
                            <p class="text-sm text-ink-900/60">Date d'expiration de l'offre</p>
                            <p class="font-semibold text-navy-900">{{ offre.dateExpiration|date('d/m/Y') }}</p>
                            <p class="text-xs text-ink-900/50">Après cette date, l'offre ne sera plus visible</p>
                        </div>
                    </div>
                {% endif %}
                {% if offre.fileDeadline %}
                    <div class="flex items-center gap-3">
                        <span class="text-2xl text-brand-700"><i class="fas fa-clock"></i></span>
                        <div>
                            <p class="text-sm text-ink-900/60">Date limite de candidature</p>
                            <p class="font-semibold text-navy-900">{{ offre.fileDeadline|date('d/m/Y') }}</p>
                            <p class="text-xs text-ink-900/50">Après cette date, le formulaire sera désactivé</p>
                        </div>
                    </div>
                {% endif %}
                {% if offre.salaireInfo %}
                    <div class="flex items-center gap-3">
                        <span class="text-2xl text-brand-700"><i class="fas fa-money-bill-wave"></i></span>
                        <div>
                            <p class="text-sm text-ink-900/60">Salaire</p>
                            <p class="font-semibold text-navy-900">{{ offre.salaireInfo }}</p>
                        </div>
                    </div>
                {% endif %}
            </div>

            {% if offre.description %}
                <div class="prose-body mb-8">
                    <h2 class="font-display text-2xl font-bold text-navy-900 mb-4">Description du poste</h2>
                    <div class="text-ink-900/80 leading-relaxed whitespace-pre-line">{{ offre.description }}</div>
                </div>
            {% endif %}

            {% if offre.fichierOffre %}
                <div class="mb-8">
                    <a href="{{ vich_uploader_asset(offre, 'fichierOffreFile') }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-brand-700 hover:text-brand-800 font-semibold transition-colors">
                        <i class="fas fa-file-pdf"></i> Télécharger le fichier de l'offre
                    </a>
                </div>
            {% endif %}

            {% if offre.isActif() and not offre.isExpired() and not offre.isFileExpired() %}
                <div class="mt-8 pt-8 border-t border-navy-200">
                    <a href="{{ path('app_candidature_new', {slug: offre.slug}) }}" class="btn-primary inline-block text-center">
                        <i class="fas fa-paper-plane mr-2"></i> Postuler à cette offre
                    </a>
                </div>
            {% elseif offre.isExpired() or offre.isFileExpired() %}
                <div class="mt-8 pt-8 border-t border-navy-200">
                    <div class="feature-card p-4 text-center text-ink-900/60">
                        <i class="fas fa-exclamation-circle mr-2 text-brand-700"></i>
                        Cette offre n'est plus disponible.
                    </div>
                </div>
            {% endif %}
        </article>
    </section>
{% endblock %}
