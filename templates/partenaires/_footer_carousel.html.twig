{% if partenaires|length > 0 %}
<div class="bg-navy-800 border-b border-white/10">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <!-- Titre -->
        <div class="text-center mb-8">
            <h2 class="text-lg font-bold uppercase tracking-wider text-brand-300 mb-2">Ils nous soutiennent</h2>
            <p class="text-sm text-brand-100/80 max-w-2xl mx-auto">
                Nos précieux partenaires qui contribuent à notre mission pour l'exclusion zéro des personnes handicapées
            </p>
        </div>

        <!-- Conteneur du carrousel -->
        <div class="relative overflow-hidden py-4">
            <!-- Effet de gradient sur les bords -->
            <div class="absolute left-0 top-0 bottom-0 w-24 bg-gradient-to-r from-navy-800 to-transparent z-10"></div>
            <div class="absolute right-0 top-0 bottom-0 w-24 bg-gradient-to-l from-navy-800 to-transparent z-10"></div>
            
            <!-- Premier carrousel (aller) -->
            <div class="flex space-x-8 animate-scroll-infinite">
                {% for partenaire in partenaires %}
                    <div class="flex-shrink-0 group relative">
                        <a {% if partenaire.url %}href="{{ partenaire.url }}" target="_blank" rel="noopener"{% endif %} 
                           class="block transform transition-all duration-500 hover:scale-110 hover:z-20"
                           {% if partenaire.url %}title="Visiter le site de {{ partenaire.nom }}"{% endif %}>
                            <div class="h-20 w-40 flex items-center justify-center rounded-xl bg-white/5 p-4 backdrop-blur-sm border border-white/10 group-hover:border-brand-500/50 group-hover:bg-white/10 transition-all duration-500">
                                {% if partenaire.logoName %}
                                    <img 
                                        src="{{ asset('/uploads/partenaires/' ~ partenaire.logoName) }}" 
                                        alt="Logo {{ partenaire.nom }}"
                                        class="max-h-12 max-w-full object-contain grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-500"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="fas fa-handshake text-2xl text-brand-400 group-hover:text-brand-300 transition-colors"></i>
                                        <span class="mt-2 text-xs text-brand-300/70 group-hover:text-brand-200 transition-colors">{{ partenaire.nom|u.truncate(15, '...') }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        
                        <!-- Tooltip au survol -->
                        <div class="absolute -top-12 left-1/2 transform -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-30">
                            <div class="bg-navy-900 text-brand-100 text-xs rounded-lg py-2 px-3 whitespace-nowrap shadow-xl border border-white/10">
                                <div class="font-semibold">{{ partenaire.nom }}</div>
                                {% if partenaire.type %}
                                    <div class="text-brand-300/70">{{ partenaire.type }}</div>
                                {% endif %}
                            </div>
                            <div class="w-2 h-2 bg-navy-900 transform rotate-45 absolute -bottom-1 left-1/2 -translate-x-1/2"></div>
                        </div>
                    </div>
                {% endfor %}
                
                <!-- Duplication pour l'effet de boucle infinie -->
                {% for partenaire in partenaires %}
                    <div class="flex-shrink-0 group relative">
                        <a {% if partenaire.url %}href="{{ partenaire.url }}" target="_blank" rel="noopener"{% endif %} 
                           class="block transform transition-all duration-500 hover:scale-110 hover:z-20"
                           {% if partenaire.url %}title="Visiter le site de {{ partenaire.nom }}"{% endif %}>
                            <div class="h-20 w-40 flex items-center justify-center rounded-xl bg-white/5 p-4 backdrop-blur-sm border border-white/10 group-hover:border-brand-500/50 group-hover:bg-white/10 transition-all duration-500">
                                {% if partenaire.logoName %}
                                    <img 
                                        src="{{ asset('/uploads/partenaires/' ~ partenaire.logoName) }}" 
                                        alt="Logo {{ partenaire.nom }}"
                                        class="max-h-12 max-w-full object-contain grayscale group-hover:grayscale-0 opacity-80 group-hover:opacity-100 transition-all duration-500"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="fas fa-handshake text-2xl text-brand-400 group-hover:text-brand-300 transition-colors"></i>
                                        <span class="mt-2 text-xs text-brand-300/70 group-hover:text-brand-200 transition-colors">{{ partenaire.nom|u.truncate(15, '...') }}</span>
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                        
                        <!-- Tooltip au survol -->
                        <div class="absolute -top-12 left-1/2 transform -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-30">
                            <div class="bg-navy-900 text-brand-100 text-xs rounded-lg py-2 px-3 whitespace-nowrap shadow-xl border border-white/10">
                                <div class="font-semibold">{{ partenaire.nom }}</div>
                                {% if partenaire.type %}
                                    <div class="text-brand-300/70">{{ partenaire.type }}</div>
                                {% endif %}
                            </div>
                            <div class="w-2 h-2 bg-navy-900 transform rotate-45 absolute -bottom-1 left-1/2 -translate-x-1/2"></div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <!-- Second carrousel (retour) - avec un délai pour créer un effet de densité -->
            <div class="flex space-x-8 animate-scroll-infinite-reverse mt-6">
                {% for partenaire in partenaires|reverse %}
                    <div class="flex-shrink-0 group relative">
                        <a {% if partenaire.url %}href="{{ partenaire.url }}" target="_blank" rel="noopener"{% endif %} 
                           class="block transform transition-all duration-500 hover:scale-110 hover:z-20"
                           {% if partenaire.url %}title="Visiter le site de {{ partenaire.nom }}"{% endif %}>
                            <div class="h-16 w-32 flex items-center justify-center rounded-xl bg-white/3 p-3 backdrop-blur-sm border border-white/5 group-hover:border-brand-500/30 group-hover:bg-white/5 transition-all duration-500">
                                {% if partenaire.logoName %}
                                    <img 
                                        src="{{ asset('/uploads/partenaires/' ~ partenaire.logoName) }}" 
                                        alt="Logo {{ partenaire.nom }}"
                                        class="max-h-10 max-w-full object-contain grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-90 transition-all duration-500"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="fas fa-handshake text-xl text-brand-500/70 group-hover:text-brand-400 transition-colors"></i>
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                    </div>
                {% endfor %}
                
                <!-- Duplication pour l'effet de boucle infinie -->
                {% for partenaire in partenaires|reverse %}
                    <div class="flex-shrink-0 group relative">
                        <a {% if partenaire.url %}href="{{ partenaire.url }}" target="_blank" rel="noopener"{% endif %} 
                           class="block transform transition-all duration-500 hover:scale-110 hover:z-20"
                           {% if partenaire.url %}title="Visiter le site de {{ partenaire.nom }}"{% endif %}>
                            <div class="h-16 w-32 flex items-center justify-center rounded-xl bg-white/3 p-3 backdrop-blur-sm border border-white/5 group-hover:border-brand-500/30 group-hover:bg-white/5 transition-all duration-500">
                                {% if partenaire.logoName %}
                                    <img 
                                        src="{{ asset('/uploads/partenaires/' ~ partenaire.logoName) }}" 
                                        alt="Logo {{ partenaire.nom }}"
                                        class="max-h-10 max-w-full object-contain grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-90 transition-all duration-500"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="flex flex-col items-center justify-center">
                                        <i class="fas fa-handshake text-xl text-brand-500/70 group-hover:text-brand-400 transition-colors"></i>
                                    </div>
                                {% endif %}
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Indicateur d'interaction -->
        <div class="text-center mt-6">
            <p class="text-xs text-brand-300/60 animate-pulse">
                <i class="fas fa-mouse-pointer mr-2"></i> Survolez un logo pour plus d'infos
            </p>
        </div>
    </div>
</div>

<!-- Styles d'animation -->
<style>
@keyframes scroll {
    0% {
        transform: translateX(0);
    }
    100% {
        transform: translateX(-50%);
    }
}

.animate-scroll-infinite {
    display: flex;
    animation: scroll 40s linear infinite;
    will-change: transform;
}

.animate-scroll-infinite-reverse {
    display: flex;
    animation: scroll 50s linear infinite reverse;
    will-change: transform;
}

.animate-scroll-infinite:hover,
.animate-scroll-infinite-reverse:hover {
    animation-play-state: paused;
}
</style>
{% endif %}