<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouveau message — Site HAKI YETU</title>
</head>
<body style="font-family: Arial, sans-serif; background:#F7F1E6; padding:24px; color:#221F1A;">
    <table role="presentation" style="max-width:560px; margin:0 auto; background:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #ECD9B8;">
        <tr>
            <td style="background:#1C3A5A; padding:20px 24px;">
                <span style="color:#ffffff; font-size:18px; font-weight:bold;">HAKI YETU asbl — Nouveau message</span>
            </td>
        </tr>
        <tr>
            <td style="padding:24px;">
                <p style="margin:0 0 12px;"><strong>Nom :</strong> {{ message.nom }}</p>
                <p style="margin:0 0 12px;"><strong>E-mail :</strong> {{ message.email }}</p>
                {% if message.sujet %}
                    <p style="margin:0 0 12px;"><strong>Sujet :</strong> {{ message.sujet }}</p>
                {% endif %}
                <p style="margin:16px 0 6px;"><strong>Message :</strong></p>
                <p style="margin:0; white-space:pre-line; line-height:1.6;">{{ message.message }}</p>
            </td>
        </tr>
        <tr>
            <td style="background:#F7F1E6; padding:14px 24px; font-size:12px; color:#6b675f;">
                Message envoyé automatiquement depuis le formulaire de contact du site HAKI YETU asbl,
                le {{ message.createdAt|date('d/m/Y à H:i') }}. Vous pouvez répondre directement à cet e-mail.
            </td>
        </tr>
    </table>
</body>
</html>
