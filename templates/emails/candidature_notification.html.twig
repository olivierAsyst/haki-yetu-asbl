<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Nouvelle candidature — Site HAKI YETU</title>
</head>
<body style="font-family: Arial, sans-serif; background:#F7F1E6; padding:24px; color:#221F1A;">
    <table role="presentation" style="max-width:560px; margin:0 auto; background:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #ECD9B8;">
        <tr>
            <td style="background:#1C3A5A; padding:20px 24px;">
                <span style="color:#ffffff; font-size:18px; font-weight:bold;">HAKI YETU asbl — Nouvelle candidature</span>
            </td>
        </tr>
        <tr>
            <td style="padding:24px;">
                <p style="margin:0 0 16px;"><strong>Offre :</strong> {{ offre.titre }} ({{ offre.typeLabel }} — {{ offre.lieu }})</p>

                <p style="margin:0 0 12px;"><strong>Candidat :</strong> {{ candidature.prenom }} {{ candidature.nom }}</p>
                <p style="margin:0 0 12px;"><strong>E-mail :</strong> {{ candidature.email }}</p>
                <p style="margin:0 0 12px;"><strong>Téléphone :</strong> {{ candidature.telephone }}</p>
                {% if candidature.adresse %}
                    <p style="margin:0 0 12px;"><strong>Adresse :</strong> {{ candidature.adresse }}</p>
                {% endif %}

                <p style="margin:16px 0 6px;"><strong>Pièces jointes déposées :</strong></p>
                <ul style="margin:0; padding-left:20px; line-height:1.6;">
                    <li>CV : {{ candidature.cvFile ? 'oui' : 'non' }}</li>
                    <li>Lettre de motivation : {{ candidature.lettreMotivationFile ? 'oui' : 'non' }}</li>
                    <li>Autres documents : {{ candidature.autresDocuments ? 'oui' : 'non' }}</li>
                </ul>

                {% if candidature.message %}
                    <p style="margin:16px 0 6px;"><strong>Message :</strong></p>
                    <p style="margin:0; white-space:pre-line; line-height:1.6;">{{ candidature.message }}</p>
                {% endif %}

                <p style="margin:24px 0 0;">
                    <a href="{{ url('admin_dashboard') }}" style="display:inline-block; background:#C1440E; color:#ffffff; padding:10px 18px; border-radius:8px; text-decoration:none; font-weight:bold;">
                        Consulter les documents dans le back-office
                    </a>
                </p>
            </td>
        </tr>
        <tr>
            <td style="background:#F7F1E6; padding:14px 24px; font-size:12px; color:#6b675f;">
                Candidature reçue le {{ candidature.createdAt|date('d/m/Y à H:i') }} via le site HAKI YETU asbl.
                Vous pouvez répondre directement à cet e-mail pour contacter le candidat.
            </td>
        </tr>
    </table>
</body>
</html>
