{% extends 'base.html.twig' %}

{% block title %}Rapports - HAKI YETU asbl{% endblock %}

{% block meta_description %}Consultez nos rapports annuels, financiers et d'activités. Téléchargez les documents officiels de HAKI YETU asbl.{% endblock %}

{% block og_title %}Rapports - HAKI YETU asbl{% endblock %}
{% block og_description %}Consultez nos rapports annuels, financiers et d'activités. Téléchargez les documents officiels de HAKI YETU asbl.{% endblock %}

{% block twitter_title %}Rapports - HAKI YETU asbl{% endblock %}
{% block twitter_description %}Consultez nos rapports annuels, financiers et d'activités. Téléchargez les documents officiels de HAKI YETU asbl.{% endblock %}

{% block body %}
<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
        <span class="section-eyebrow">Transparence et redevabilité</span>
        <h1 class="mt-2 font-display text-4xl font-bold text-navy-900 md:text-5xl">Nos Rapports</h1>
        <p class="mx-auto mt-6 max-w-2xl prose-body">
            Consultez nos rapports officiels, documents de transparence et publications. 
            Téléchargez nos rapports annuels, financiers et d'activités pour suivre notre impact.
        </p>
    </div>

    <div class="mb-8 rounded-2xl bg-white p-6 shadow-lg shadow-navy-900/10">
        <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Filtres de recherche</h2>
        
        <form method="get" class="grid gap-4 md:grid-cols-4">
            <div>
                <label class="mb-2 block text-sm font-medium text-navy-700" for="annee">Année</label>
                <select id="annee" name="annee" class="input-modern w-full">
                    <option value="">Toutes les années</option>
                    {% for annee in annees %}
                        <option value="{{ annee }}" {{ filters.annee == annee ? 'selected' : '' }}>{{ annee }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div>
                <label class="mb-2 block text-sm font-medium text-navy-700" for="type">Type</label>
                <select id="type" name="type" class="input-modern w-full">
                    <option value="">Tous les types</option>
                    {% for type in types %}
                        <option value="{{ type }}" {{ filters.type == type ? 'selected' : '' }}>{{ type|capitalize }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div>
                <label class="mb-2 block text-sm font-medium text-navy-700" for="langue">Langue</label>
                <select id="langue" name="langue" class="input-modern w-full">
                    <option value="">Toutes les langues</option>
                    {% for langue in langues %}
                        {% set lang_label = langue == 'fr' ? 'Français' : (langue == 'en' ? 'Anglais' : (langue == 'sw' ? 'Swahili' : (langue == 'ln' ? 'Lingala' : langue))) %}
                        <option value="{{ langue }}" {{ filters.langue == langue ? 'selected' : '' }}>{{ lang_label }}</option>
                    {% endfor %}
                </select>
            </div>
            
            <div class="flex items-end">
                <button type="submit" class="btn-primary w-full">
                    <i class="fas fa-search"></i> Rechercher
                </button>
            </div>
        </form>
        
        {% if filters.search %}
            <div class="mt-4 flex items-center justify-between">
                <p class="text-sm text-navy-600">Résultats pour : "{{ filters.search }}"</p>
                <a href="{{ path('app_rapports_index') }}" class="text-sm text-brand-700 hover:text-brand-800">
                    <i class="fas fa-times"></i> Effacer la recherche
                </a>
            </div>
        {% endif %}
    </div>

    {% if rapports is empty %}
        <div class="rounded-2xl bg-white p-12 text-center shadow-lg shadow-navy-900/10">
            <i class="fas fa-file-alt text-5xl text-navy-300 mb-6"></i>
            <h3 class="font-display text-2xl font-bold text-navy-900 mb-4">Aucun rapport trouvé</h3>
            <p class="prose-body mb-6">Aucun rapport ne correspond à vos critères de recherche.</p>
            <a href="{{ path('app_rapports_index') }}" class="btn-secondary">
                <i class="fas fa-redo"></i> Réinitialiser les filtres
            </a>
        </div>
    {% else %}
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for rapport in rapports %}
                <div class="card-modern">
                    <div class="p-6">
                        <div class="mb-4 flex items-start justify-between">
                            <div class="flex items-center gap-3">
                                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-navy-100 text-navy-700">
                                    <i class="{{ rapport.getFichierIcone() }} text-xl"></i>
                                </div>
                                <div>
                                    <span class="badge-modern badge-primary">{{ rapport.type|capitalize }}</span>
                                    {% if rapport.langue %}
                                        <span class="ml-2 badge-modern badge-secondary">{{ rapport.langue|upper }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            
                            {% if is_granted('ROLE_ADMIN') %}
                                <div class="relative">
                                    <button class="flex h-8 w-8 items-center justify-center rounded-lg text-navy-600 hover:bg-navy-100" type="button" id="menu-button-{{ rapport.id }}">
                                        <i class="fas fa-ellipsis-v"></i>
                                    </button>
                                    <div class="absolute right-0 mt-2 w-48 rounded-lg border border-navy-200 bg-white py-2 shadow-xl opacity-0 invisible" id="dropdown-{{ rapport.id }}">
                                        <a href="{{ path('app_rapports_edit', {'id': rapport.id}) }}" class="block px-4 py-2 text-sm text-navy-900 hover:bg-brand-50">
                                            <i class="fas fa-edit mr-2"></i> Modifier
                                        </a>
                                        <form action="{{ path('app_rapports_delete', {'id': rapport.id}) }}" method="post" class="block" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rapport ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rapport.id) }}">
                                            <button type="submit" class="w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50">
                                                <i class="fas fa-trash mr-2"></i> Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </div>
                                
                                <script>
                                    document.getElementById('menu-button-{{ rapport.id }}').addEventListener('click', function() {
                                        const dropdown = document.getElementById('dropdown-{{ rapport.id }}');
                                        dropdown.classList.toggle('opacity-0');
                                        dropdown.classList.toggle('invisible');
                                    });
                                </script>
                            {% endif %}
                        </div>
                        
                        <h3 class="mb-3 font-display text-xl font-bold text-navy-900 leading-tight">{{ rapport.titre }}</h3>
                        
                        {% if rapport.description %}
                            <p class="mb-4 text-sm text-navy-600 line-clamp-3">{{ rapport.description|u.truncate(150, '...') }}</p>
                        {% endif %}
                        
                        <div class="mb-6 flex flex-wrap gap-2">
                            {% if rapport.annee %}
                                <span class="tag tag-blue">
                                    <i class="fas fa-calendar mr-1"></i> {{ rapport.annee }}
                                </span>
                            {% endif %}
                            
                            {% if rapport.periode %}
                                <span class="tag tag-green">
                                    <i class="fas fa-clock mr-1"></i> {{ rapport.periode }}
                                </span>
                            {% endif %}
                            
                            {% if rapport.datePublication %}
                                <span class="tag tag-orange">
                                    <i class="fas fa-calendar-alt mr-1"></i> {{ rapport.datePublication|date('d/m/Y') }}
                                </span>
                            {% endif %}
                        </div>
                        
                        <div class="flex flex-col gap-3">
                            <a href="{{ path('app_rapports_show', {'id': rapport.id}) }}" class="btn-tertiary text-center">
                                <i class="fas fa-eye mr-2"></i> Voir les détails
                            </a>
                            
                            {% if rapport.fichierName %}
                                <a href="{{ path('app_rapports_download', {'id': rapport.id}) }}" class="btn-primary text-center">
                                    <i class="fas fa-download mr-2"></i> Télécharger
                                    <span class="ml-2 text-xs opacity-80">({{ (rapport.fichierSize / 1024 / 1024)|round(2) }} Mo)</span>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
        
        <div class="mt-12 text-center">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_rapports_new') }}" class="btn-primary">
                    <i class="fas fa-plus mr-2"></i> Ajouter un nouveau rapport
                </a>
            {% endif %}
        </div>
    {% endif %}
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Fermer les dropdowns quand on clique ailleurs
        document.addEventListener('click', function(event) {
            if (!event.target.closest('[id^="menu-button-"]') && !event.target.closest('[id^="dropdown-"]')) {
                document.querySelectorAll('[id^="dropdown-"]').forEach(dropdown => {
                    dropdown.classList.add('opacity-0', 'invisible');
                });
            }
        });
    });
</script>
{% endblock %}