{% extends 'base.html.twig' %}

{% block title %}{{ rapport.titre }} - Rapports HAKI YETU asbl{% endblock %}

{% block meta_description %}{{ rapport.description ? rapport.description|u.truncate(160, '...') : 'Téléchargez ce rapport officiel de HAKI YETU asbl.' }}{% endblock %}

{% block og_title %}{{ rapport.titre }} - Rapports HAKI YETU asbl{% endblock %}
{% block og_description %}{{ rapport.description ? rapport.description|u.truncate(160, '...') : 'Téléchargez ce rapport officiel de HAKI YETU asbl.' }}{% endblock %}

{% block twitter_title %}{{ rapport.titre }} - Rapports HAKI YETU asbl{% endblock %}
{% block twitter_description %}{{ rapport.description ? rapport.description|u.truncate(160, '...') : 'Téléchargez ce rapport officiel de HAKI YETU asbl.' }}{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8">
        <a href="{{ path('app_rapports_index') }}" class="inline-flex items-center text-brand-700 hover:text-brand-800 mb-6">
            <i class="fas fa-arrow-left mr-2"></i> Retour aux rapports
        </a>
        
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
                <span class="section-eyebrow">Rapport</span>
                <h1 class="mt-2 font-display text-3xl font-bold text-navy-900 md:text-4xl">{{ rapport.titre }}</h1>
            </div>
            
            {% if is_granted('ROLE_ADMIN') %}
                <div class="flex gap-2">
                    <a href="{{ path('app_rapports_edit', {'id': rapport.id}) }}" class="btn-secondary">
                        <i class="fas fa-edit mr-2"></i> Modifier
                    </a>
                    <form action="{{ path('app_rapports_delete', {'id': rapport.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce rapport ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rapport.id) }}">
                        <button type="submit" class="rounded-xl border-2 border-red-600 px-4 py-2 text-sm font-semibold text-red-600 transition-all duration-300 hover:bg-red-600 hover:text-white">
                            <i class="fas fa-trash mr-2"></i> Supprimer
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
        
        <div class="mb-8 flex flex-wrap gap-3">
            {% if rapport.type %}
                <span class="badge-modern badge-primary">
                    <i class="fas fa-tag mr-1"></i> {{ rapport.type|capitalize }}
                </span>
            {% endif %}
            
            {% if rapport.annee %}
                <span class="badge-modern badge-secondary">
                    <i class="fas fa-calendar mr-1"></i> {{ rapport.annee }}
                </span>
            {% endif %}
            
            {% if rapport.langue %}
                <span class="badge-modern badge-secondary">
                    <i class="fas fa-language mr-1"></i> 
                    {% if rapport.langue == 'fr' %}Français
                    {% elseif rapport.langue == 'en' %}Anglais
                    {% elseif rapport.langue == 'sw' %}Swahili
                    {% elseif rapport.langue == 'ln' %}Lingala
                    {% else %}{{ rapport.langue|capitalize }}
                    {% endif %}
                </span>
            {% endif %}
            
            {% if rapport.fichierName %}
                <span class="badge-modern badge-success">
                    <i class="{{ rapport.getFichierIcone() }} mr-1"></i> 
                    {{ rapport.getFichierExtension()|upper }}
                    ({{ (rapport.fichierSize / 1024 / 1024)|round(2) }} Mo)
                </span>
            {% endif %}
        </div>
    </div>
    
    <div class="grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <div class="card-modern">
                <div class="p-6">
                    <h2 class="mb-4 font-display text-xl font-bold text-navy-900">À propos de ce rapport</h2>
                    
                    {% if rapport.description %}
                        <div class="prose-body mb-6">
                            {{ rapport.description|nl2br }}
                        </div>
                    {% else %}
                        <p class="mb-6 text-navy-600 italic">Aucune description n'est disponible pour ce rapport.</p>
                    {% endif %}
                    
                    {% if rapport.periode %}
                        <div class="mb-4">
                            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-navy-700">Période / Exercice</h3>
                            <p class="text-navy-900">{{ rapport.periode }}</p>
                        </div>
                    {% endif %}
                    
                    <div class="mb-6 grid gap-4 sm:grid-cols-2">
                        {% if rapport.datePublication %}
                            <div>
                                <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-navy-700">Date de publication</h3>
                                <p class="text-navy-900">{{ rapport.datePublication|date('d F Y') }}</p>
                            </div>
                        {% endif %}
                        
                        <div>
                            <h3 class="mb-2 text-sm font-semibold uppercase tracking-wider text-navy-700">Dernière mise à jour</h3>
                            <p class="text-navy-900">{{ rapport.updatedAt|date('d F Y') }}</p>
                        </div>
                    </div>
                    
                    {% if rapport.fichierName %}
                        <div class="mt-8">
                            <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Télécharger le rapport</h2>
                            <div class="rounded-xl border-2 border-dashed border-navy-200 bg-navy-50 p-6 text-center">
                                <div class="mb-4 flex justify-center">
                                    <div class="flex h-16 w-16 items-center justify-center rounded-xl bg-white text-navy-700 shadow-md">
                                        <i class="{{ rapport.getFichierIcone() }} text-3xl"></i>
                                    </div>
                                </div>
                                <h3 class="mb-2 font-display text-lg font-bold text-navy-900">{{ rapport.titre }}</h3>
                                <p class="mb-4 text-sm text-navy-600">
                                    Fichier {{ rapport.getFichierExtension()|upper }} • 
                                    {{ (rapport.fichierSize / 1024 / 1024)|round(2) }} Mo
                                </p>
                                <a href="{{ path('app_rapports_download', {'id': rapport.id}) }}" class="btn-primary">
                                    <i class="fas fa-download mr-2"></i> Télécharger maintenant
                                </a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div>
            <div class="card-modern mb-6">
                <div class="p-6">
                    <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Informations du document</h2>
                    <ul class="space-y-4">
                        <li>
                            <span class="block text-sm font-medium text-navy-700">Type</span>
                            <span class="text-navy-900">{{ rapport.type|capitalize ?? 'Non spécifié' }}</span>
                        </li>
                        <li>
                            <span class="block text-sm font-medium text-navy-700">Année</span>
                            <span class="text-navy-900">{{ rapport.annee ?? 'Non spécifiée' }}</span>
                        </li>
                        <li>
                            <span class="block text-sm font-medium text-navy-700">Langue</span>
                            <span class="text-navy-900">
                                {% if rapport.langue == 'fr' %}Français
                                {% elseif rapport.langue == 'en' %}Anglais
                                {% elseif rapport.langue == 'sw' %}Swahili
                                {% elseif rapport.langue == 'ln' %}Lingala
                                {% else %}{{ rapport.langue|capitalize ?? 'Non spécifiée' }}
                                {% endif %}
                            </span>
                        </li>
                        <li>
                            <span class="block text-sm font-medium text-navy-700">Format</span>
                            <span class="text-navy-900">{{ rapport.getFichierExtension()|upper ?? 'Non spécifié' }}</span>
                        </li>
                        <li>
                            <span class="block text-sm font-medium text-navy-700">Taille</span>
                            <span class="text-navy-900">
                                {% if rapport.fichierSize %}
                                    {{ (rapport.fichierSize / 1024 / 1024)|round(2) }} Mo
                                {% else %}
                                    Non spécifiée
                                {% endif %}
                            </span>
                        </li>
                        <li>
                            <span class="block text-sm font-medium text-navy-700">Date d'ajout</span>
                            <span class="text-navy-900">{{ rapport.createdAt|date('d/m/Y') }}</span>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="card-modern">
                <div class="p-6">
                    <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Partager</h2>
                    <div class="flex gap-3">
                        <a href="https://www.facebook.com/sharer/sharer.php?u={{ app.request.uri|url_encode }}" 
                           target="_blank" 
                           class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-600 text-white hover:bg-blue-700">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://twitter.com/intent/tweet?text={{ rapport.titre|url_encode }}&url={{ app.request.uri|url_encode }}" 
                           target="_blank" 
                           class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-400 text-white hover:bg-blue-500">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="mailto:?subject={{ rapport.titre|url_encode }}&body={{ app.request.uri|url_encode }}" 
                           class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-700 text-white hover:bg-brand-800">
                            <i class="fas fa-envelope"></i>
                        </a>
                        <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ app.request.uri|url_encode }}&title={{ rapport.titre|url_encode }}" 
                           target="_blank" 
                           class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-800 text-white hover:bg-blue-900">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-12 text-center">
        <a href="{{ path('app_rapports_index') }}" class="btn-secondary">
            <i class="fas fa-list mr-2"></i> Voir tous les rapports
        </a>
    </div>
</div>
{% endblock %}