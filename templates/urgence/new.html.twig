{% extends 'base.html.twig' %}

{% block title %}Nouvelle urgence — Administration HAKI YETU{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-brand-50/30 to-white">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <!-- Header -->
        <div class="mb-10">
            <div class="flex items-center gap-4 mb-6">
                <a href="{{ path('app_urgence_index') }}" 
                   class="flex h-10 w-10 items-center justify-center rounded-full bg-navy-100 text-navy-600 hover:bg-navy-200">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="text-3xl font-display font-bold text-navy-900">
                    Nouvel appel d'urgence
                </h1>
            </div>
            <p class="text-navy-600">
                Créez un nouvel appel d'urgence pour mobiliser des fonds et soutenir les personnes handicapées en situation critique.
            </p>
        </div>

        <!-- Form -->
        <div class="overflow-hidden rounded-2xl border border-navy-200 bg-white shadow-xl">
            <div class="border-b border-navy-200 bg-red-50 px-8 py-6">
                <h2 class="text-xl font-display font-bold text-navy-900">Détails de l'urgence</h2>
                <p class="text-sm text-navy-600 mt-2">
                    Remplissez tous les champs pour créer un appel d'urgence efficace.
                </p>
            </div>

            <div class="p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}
                    
                    <!-- Titre et Type -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Un titre clair et impactant pour attirer l'attention.
                            </div>
                        </div>
                        
                        <div>
                            {{ form_label(form.type, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Type de situation d'urgence.
                            </div>
                        </div>
                    </div>

                    <!-- Lieu et Dates -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.lieu, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.lieu, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Localisation précise de l'urgence.
                            </div>
                        </div>
                        
                        <div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.dateDebut, {'attr': {'class': 'form-input'}}) }}
                                </div>
                                <div>
                                    {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.dateFin, {'attr': {'class': 'form-input'}}) }}
                                </div>
                            </div>
                            <div class="text-sm text-navy-500 mt-1">
                                Dates de début et fin prévue de l'appel.
                            </div>
                        </div>
                    </div>

                    <!-- Montants -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.montantCible, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.montantCible, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Montant total nécessaire pour répondre à l'urgence.
                            </div>
                        </div>
                        
                        <div>
                            {{ form_label(form.montantCollecte, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.montantCollecte, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Montant déjà collecté (si applicable).
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div>
                        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-textarea', 'rows': 8}}) }}
                        <div class="text-sm text-navy-500 mt-1">
                            Décrivez la situation, les besoins spécifiques et l'impact sur la communauté.
                        </div>
                    </div>

                    <!-- Statut et Active -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                        </div>
                        
                        <div>
                            {{ form_label(form.estActive, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="mt-2">
                                {{ form_widget(form.estActive, {'attr': {'class': 'space-x-6'}}) }}
                            </div>
                            <div class="text-sm text-navy-500 mt-2">
                                Une urgence inactive n'apparaîtra pas sur le site public.
                            </div>
                        </div>
                    </div>

                    <!-- Form Errors -->
                    {% if not form.vars.valid %}
                        <div class="rounded-lg border border-red-200 bg-red-50 p-4">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-exclamation-triangle text-red-500"></i>
                                <div>
                                    <h3 class="font-medium text-red-800">Erreurs de validation</h3>
                                    <p class="text-sm text-red-700 mt-1">
                                        Veuillez corriger les erreurs dans le formulaire.
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Actions -->
                    <div class="flex flex-wrap items-center justify-between gap-4 pt-8 border-t border-navy-200">
                        <div>
                            <a href="{{ path('app_urgence_index') }}" 
                               class="text-navy-600 hover:text-navy-900 font-medium">
                                <i class="fas fa-arrow-left mr-2"></i>Retour aux urgences
                            </a>
                        </div>
                        <div class="flex flex-wrap gap-4">
                            <button type="submit" class="btn-humanitarian bg-gradient-to-r from-red-600 to-orange-600 hover:from-red-700 hover:to-orange-700">
                                <i class="fas fa-save mr-2"></i>Créer l'appel d'urgence
                            </button>
                            <button type="reset" class="btn-humanitarian-secondary">
                                <i class="fas fa-redo mr-2"></i>Réinitialiser
                            </button>
                        </div>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

        <!-- Tips -->
        <div class="mt-12 rounded-2xl border border-sage-200 bg-sage-50/50 p-8">
            <h3 class="text-lg font-display font-bold text-navy-900 mb-4">
                <i class="fas fa-lightbulb text-sage-600 mr-2"></i>
                Conseils pour un appel d'urgence efficace
            </h3>
            <ul class="space-y-3 text-navy-700">
                <li class="flex items-start gap-3">
                    <i class="fas fa-check text-sage-500 mt-1"></i>
                    <span>Soyez précis sur les besoins : quantifiez les personnes à aider, les besoins spécifiques (nourriture, eau, médicaments, abris).</span>
                </li>
                <li class="flex items-start gap-3">
                    <i class="fas fa-check text-sage-500 mt-1"></i>
                    <span>Utilisez des montants réalistes : décomposez le coût total pour montrer où va chaque contribution.</span>
                </li>
                <li class="flex items-start gap-3">
                    <i class="fas fa-check text-sage-500 mt-1"></i>
                    <span>Mettez l'accent sur l'impact : expliquez comment les dons vont aider concrètement les personnes handicapées.</span>
                </li>
                <li class="flex items-start gap-3">
                    <i class="fas fa-check text-sage-500 mt-1"></i>
                    <span>Proposez des montants suggérés : cela aide les donateurs à se situer dans leur contribution.</span>
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}