{% extends 'base.html.twig' %}

{% block title %}Modifier l'urgence {{ urgence.titre }} — Administration HAKI YETU{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-brand-50/30 to-white">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <!-- Header -->
        <div class="mb-10">
            <div class="flex items-center gap-4 mb-6">
                <a href="{{ path('app_urgence_show', {'id': urgence.id}) }}" 
                   class="flex h-10 w-10 items-center justify-center rounded-full bg-navy-100 text-navy-600 hover:bg-navy-200">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="text-3xl font-display font-bold text-navy-900">
                    Modifier l'appel d'urgence
                </h1>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-sm px-3 py-1 rounded-full bg-brand-100 text-brand-800">
                    {{ urgence.statut|replace({'_': ' '})|title }}
                </div>
                <div class="text-sm text-navy-600">
                    Créé le {{ urgence.createdAt|date('d/m/Y') }}
                </div>
                {% if urgence.updatedAt %}
                    <div class="text-sm text-navy-600">
                        Dernière mise à jour : {{ urgence.updatedAt|date('d/m/Y') }}
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Form -->
        <div class="overflow-hidden rounded-2xl border border-navy-200 bg-white shadow-xl">
            <div class="border-b border-navy-200 bg-orange-50 px-8 py-6">
                <h2 class="text-xl font-display font-bold text-navy-900">Modifier {{ urgence.titre }}</h2>
                <p class="text-sm text-navy-600 mt-2">
                    Mettez à jour les informations de cette urgence. Les modifications apparaîtront immédiatement sur le site.
                </p>
            </div>

            <div class="p-8">
                {{ form_start(form, {'attr': {'class': 'space-y-8'}}) }}
                    
                    <!-- Titre et Type -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.titre, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Modifiez le titre si nécessaire pour mieux refléter l'urgence actuelle.
                            </div>
                        </div>
                        
                        <div>
                            {{ form_label(form.type, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.type, {'attr': {'class': 'form-select'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Type de situation d'urgence.
                            </div>
                        </div>
                    </div>

                    <!-- Lieu et Dates -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.lieu, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.lieu, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Localisation précise de l'urgence.
                            </div>
                        </div>
                        
                        <div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.dateDebut, {'attr': {'class': 'form-input'}}) }}
                                </div>
                                <div>
                                    {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.dateFin, {'attr': {'class': 'form-input'}}) }}
                                </div>
                            </div>
                            <div class="text-sm text-navy-500 mt-1">
                                Dates de début et fin prévue de l'appel.
                            </div>
                        </div>
                    </div>

                    <!-- Montants -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.montantCible, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.montantCible, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Montant total nécessaire pour répondre à l'urgence.
                            </div>
                        </div>
                        
                        <div>
                            {{ form_label(form.montantCollecte, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.montantCollecte, {'attr': {'class': 'form-input'}}) }}
                            <div class="text-sm text-navy-500 mt-1">
                                Mettez à jour le montant collecté au fur et à mesure des dons.
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div>
                        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-textarea', 'rows': 8}}) }}
                        <div class="text-sm text-navy-500 mt-1">
                            Mettez à jour la description avec les dernières informations sur la situation.
                        </div>
                    </div>

                    <!-- Statut et Active -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
                            <div class="text-sm text-navy-500 mt-2">
                                Changez le statut selon l'avancement de la collecte.
                            </div>
                        </div>
                        
                        <div>
                            {{ form_label(form.estActive, null, {'label_attr': {'class': 'form-label'}}) }}
                            <div class="mt-2">
                                {{ form_widget(form.estActive, {'attr': {'class': 'space-x-6'}}) }}
                            </div>
                            <div class="text-sm text-navy-500 mt-2">
                                Désactivez si l'urgence est terminée ou suspendue.
                            </div>
                        </div>
                    </div>

                    <!-- Current Progress -->
                    <div class="rounded-xl border border-brand-200 bg-brand-50 p-6">
                        <h3 class="font-display font-bold text-navy-900 mb-4">Progression actuelle</h3>
                        <div class="grid grid-cols-3 gap-6">
                            <div class="text-center">
                                <div class="text-2xl font-display font-bold text-brand-600 mb-1">
                                    {{ urgence.getPourcentageCollecte }}%
                                </div>
                                <div class="text-sm text-navy-700">Objectif atteint</div>
                            </div>
                            <div class="text-center">
                                <div class="text-2xl font-display font-bold text-navy-600 mb-1">
                                    {{ urgence.montantCollecte|number_format(0, ',', ' ') }}
                                </div>
                                <div class="text-sm text-navy-700">CDF collectés</div>
                            </div>
                            <div class="text-center">
                                <div class="text-2xl font-display font-bold text-green-600 mb-1">
                                    {% if urgence.getJoursRestants %}
                                        {{ urgence.getJoursRestants }}
                                    {% else %}
                                        ∞
                                    {% endif %}
                                </div>
                                <div class="text-sm text-navy-700">Jours restants</div>
                            </div>
                        </div>
                    </div>

                    <!-- Form Errors -->
                    {% if not form.vars.valid %}
                        <div class="rounded-lg border border-red-200 bg-red-50 p-4">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-exclamation-triangle text-red-500"></i>
                                <div>
                                    <h3 class="font-medium text-red-800">Erreurs de validation</h3>
                                    <p class="text-sm text-red-700 mt-1">
                                        Veuillez corriger les erreurs dans le formulaire.
                                    </p>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Actions -->
                    <div class="flex flex-wrap items-center justify-between gap-4 pt-8 border-t border-navy-200">
                        <div class="space-x-4">
                            <a href="{{ path('app_urgence_show', {'id': urgence.id}) }}" 
                               class="text-navy-600 hover:text-navy-900 font-medium">
                                <i class="fas fa-eye mr-2"></i>Voir la page publique
                            </a>
                            <a href="{{ path('app_urgence_index') }}" 
                               class="text-navy-600 hover:text-navy-900 font-medium">
                                <i class="fas fa-list mr-2"></i>Toutes les urgences
                            </a>
                        </div>
                        <div class="flex flex-wrap gap-4">
                            <button type="submit" class="btn-humanitarian bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-700 hover:to-amber-700">
                                <i class="fas fa-save mr-2"></i>Enregistrer les modifications
                            </button>
                            <button type="reset" class="btn-humanitarian-secondary">
                                <i class="fas fa-redo mr-2"></i>Réinitialiser
                            </button>
                        </div>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>

        <!-- Danger Zone -->
        <div class="mt-12 overflow-hidden rounded-2xl border border-red-200 bg-red-50/50">
            <div class="border-b border-red-200 bg-red-100 px-8 py-4">
                <h3 class="text-lg font-display font-bold text-red-800">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Zone de danger
                </h3>
            </div>
            <div class="p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <h4 class="font-medium text-red-800 mb-3">Supprimer cette urgence</h4>
                        <p class="text-sm text-red-700 mb-4">
                            Cette action est irréversible. L'urgence et toutes ses données seront supprimées définitivement.
                        </p>
                        <form action="{{ path('app_urgence_delete', {'id': urgence.id}) }}" method="post" 
                              onsubmit="return confirm('Êtes-vous ABSOLUMENT sûr de vouloir supprimer cette urgence ? Cette action est irréversible.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ urgence.id) }}">
                            <button type="submit" class="w-full btn-humanitarian-secondary bg-red-600 text-white hover:bg-red-700 border-red-600">
                                <i class="fas fa-trash mr-2"></i>Supprimer définitivement
                            </button>
                        </form>
                    </div>
                    
                    <div>
                        <h4 class="font-medium text-red-800 mb-3">Archiver cette urgence</h4>
                        <p class="text-sm text-red-700 mb-4">
                            Si l'urgence est terminée, vous pouvez l'archiver. Elle restera visible mais marquée comme terminée.
                        </p>
                        <a href="#" 
                           onclick="if(confirm('Archiver cette urgence ? Elle sera marquée comme terminée.')) { document.getElementById('archive-form').submit(); } return false;"
                           class="w-full block text-center btn-humanitarian-secondary border-amber-500 text-amber-700 hover:bg-amber-100">
                            <i class="fas fa-archive mr-2"></i>Archiver comme terminée
                        </a>
                        <form id="archive-form" action="{{ path('app_urgence_edit', {'id': urgence.id}) }}" method="post" style="display: none;">
                            <input type="hidden" name="urgence[statut]" value="urgence_terminee">
                            <input type="hidden" name="urgence[_token]" value="{{ form._token.vars.value }}">
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}