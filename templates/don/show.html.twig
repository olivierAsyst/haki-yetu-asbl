{% extends 'base.html.twig' %}

{% block title %}Don #{{ don.id }} - HAKI YETU asbl{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8">
        <a href="{{ path('app_don_admin') }}" class="inline-flex items-center text-brand-700 hover:text-brand-800 mb-6">
            <i class="fas fa-arrow-left mr-2"></i> Retour à la liste
        </a>
        
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
                <span class="section-eyebrow">Détails du don</span>
                <h1 class="mt-2 font-display text-3xl font-bold text-navy-900 md:text-4xl">Don #{{ '%06d'|format(don.id) }}</h1>
                <p class="mt-4 prose-body">
                    Détails complets du don et gestion du statut.
                </p>
            </div>
            
            <div class="flex gap-2">
                <a href="{{ path('app_don_edit', {'id': don.id}) }}" class="btn-secondary">
                    <i class="fas fa-edit mr-2"></i> Modifier
                </a>
            </div>
        </div>
    </div>
    
    <div class="grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
            <div class="card-modern mb-6">
                <div class="p-6">
                    <div class="mb-6 flex items-center justify-between">
                        <div>
                            <h2 class="font-display text-2xl font-bold text-navy-900">{{ don.getMontantFormate() }}</h2>
                            <p class="text-sm text-navy-600">{{ don.getTypeDonLabel() }} • {{ don.getMethodePaiementLabel() }}</p>
                        </div>
                        
                        {% set statut_couleurs = {
                            'en_attente': 'bg-yellow-100 text-yellow-800',
                            'confirme': 'bg-blue-100 text-blue-800',
                            'paye': 'bg-green-100 text-green-800',
                            'annule': 'bg-red-100 text-red-800',
                            'rembourse': 'bg-gray-100 text-gray-800'
                        } %}
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium {{ statut_couleurs[don.statut] }}">
                            {{ don.getStatutLabel() }}
                        </span>
                    </div>
                    
                    <!-- Actions de statut -->
                    <div class="mb-6">
                        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-navy-700">Changer le statut</h3>
                        <div class="flex flex-wrap gap-2">
                            <form action="{{ path('app_don_changer_statut', {'id': don.id, 'statut': 'confirme'}) }}" method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ don.id) }}">
                                <button type="submit" class="inline-flex items-center rounded-lg border border-blue-300 bg-blue-50 px-3 py-2 text-xs font-medium text-blue-700 hover:bg-blue-100">
                                    <i class="fas fa-check mr-1"></i> Confirmer
                                </button>
                            </form>
                            <form action="{{ path('app_don_changer_statut', {'id': don.id, 'statut': 'paye'}) }}" method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ don.id) }}">
                                <button type="submit" class="inline-flex items-center rounded-lg border border-green-300 bg-green-50 px-3 py-2 text-xs font-medium text-green-700 hover:bg-green-100">
                                    <i class="fas fa-money-bill-wave mr-1"></i> Marquer comme payé
                                </button>
                            </form>
                            <form action="{{ path('app_don_changer_statut', {'id': don.id, 'statut': 'annule'}) }}" method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ don.id) }}">
                                <button type="submit" class="inline-flex items-center rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-xs font-medium text-red-700 hover:bg-red-100">
                                    <i class="fas fa-times mr-1"></i> Annuler
                                </button>
                            </form>
                            <form action="{{ path('app_don_changer_statut', {'id': don.id, 'statut': 'rembourse'}) }}" method="post" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('statut' ~ don.id) }}">
                                <button type="submit" class="inline-flex items-center rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-xs font-medium text-gray-700 hover:bg-gray-100">
                                    <i class="fas fa-undo mr-1"></i> Rembourser
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    <!-- Informations du don -->
                    <div class="grid gap-6 md:grid-cols-2">
                        <div>
                            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-navy-700">Informations du don</h3>
                            <dl class="space-y-2">
                                <div>
                                    <dt class="text-xs text-navy-600">Date de création</dt>
                                    <dd class="text-sm text-navy-900">{{ don.createdAt|date('d/m/Y à H:i') }}</dd>
                                </div>
                                {% if don.datePaiement %}
                                    <div>
                                        <dt class="text-xs text-navy-600">Date de paiement</dt>
                                        <dd class="text-sm text-navy-900">{{ don.datePaiement|date('d/m/Y à H:i') }}</dd>
                                    </div>
                                {% endif %}
                                <div>
                                    <dt class="text-xs text-navy-600">Devise</dt>
                                    <dd class="text-sm text-navy-900">{{ don.devise }}</dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-navy-600">Type de don</dt>
                                    <dd class="text-sm text-navy-900">{{ don.getTypeDonLabel() }}</dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-navy-600">Méthode de paiement</dt>
                                    <dd class="text-sm text-navy-900">{{ don.getMethodePaiementLabel() }}</dd>
                                </div>
                                <div>
                                    <dt class="text-xs text-navy-600">Référence paiement</dt>
                                    <dd class="text-sm text-navy-900 font-mono">{{ don.referencePaiement ?? 'Non renseignée' }}</dd>
                                </div>
                            </dl>
                        </div>
                        
                        <div>
                            <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-navy-700">Options</h3>
                            <dl class="space-y-2">
                                <div class="flex items-center">
                                    <dt class="text-xs text-navy-600 mr-2">Anonyme</dt>
                                    <dd class="text-sm text-navy-900">
                                        {% if don.anonyme %}
                                            <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-800">
                                                <i class="fas fa-check mr-1"></i> Oui
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-medium text-red-800">
                                                <i class="fas fa-times mr-1"></i> Non
                                            </span>
                                        {% endif %}
                                    </dd>
                                </div>
                                <div class="flex items-center">
                                    <dt class="text-xs text-navy-600 mr-2">Reçu fiscal</dt>
                                    <dd class="text-sm text-navy-900">
                                        {% if don.receiptDemande %}
                                            <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-800">
                                                <i class="fas fa-check mr-1"></i> Demandé
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-medium text-red-800">
                                                <i class="fas fa-times mr-1"></i> Non demandé
                                            </span>
                                        {% endif %}
                                    </dd>
                                </div>
                                <div class="flex items-center">
                                    <dt class="text-xs text-navy-600 mr-2">Newsletter</dt>
                                    <dd class="text-sm text-navy-900">
                                        {% if don.recevoirNewsletter %}
                                            <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs font-medium text-green-800">
                                                <i class="fas fa-check mr-1"></i> Abonné
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs font-medium text-red-800">
                                                <i class="fas fa-times mr-1"></i> Non abonné
                                            </span>
                                        {% endif %}
                                    </dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Informations du donateur -->
            <div class="card-modern mb-6">
                <div class="p-6">
                    <h3 class="mb-4 font-display text-xl font-bold text-navy-900">Informations du donateur</h3>
                    
                    <div class="grid gap-6 md:grid-cols-2">
                        <div>
                            <dl class="space-y-3">
                                <div>
                                    <dt class="text-xs font-medium text-navy-700">Nom</dt>
                                    <dd class="text-sm text-navy-900">
                                        {% if don.anonyme %}
                                            <span class="italic">Anonyme</span>
                                        {% else %}
                                            {{ don.nom }}
                                        {% endif %}
                                    </dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-medium text-navy-700">Email</dt>
                                    <dd class="text-sm text-navy-900">{{ don.email }}</dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-medium text-navy-700">Téléphone</dt>
                                    <dd class="text-sm text-navy-900">{{ don.telephone ?? 'Non renseigné' }}</dd>
                                </div>
                                <div>
                                    <dt class="text-xs font-medium text-navy-700">Type</dt>
                                    <dd class="text-sm text-navy-900">
                                        {% if don.typePersonne == 'particulier' %}
                                            Particulier
                                        {% else %}
                                            Entreprise/Organisation
                                        {% endif %}
                                    </dd>
                                </div>
                                {% if don.entreprise %}
                                    <div>
                                        <dt class="text-xs font-medium text-navy-700">Entreprise</dt>
                                        <dd class="text-sm text-navy-900">{{ don.entreprise }}</dd>
                                    </div>
                                {% endif %}
                            </dl>
                        </div>
                        
                        <div>
                            <dl class="space-y-3">
                                {% if don.adresse %}
                                    <div>
                                        <dt class="text-xs font-medium text-navy-700">Adresse</dt>
                                        <dd class="text-sm text-navy-900">{{ don.adresse }}</dd>
                                    </div>
                                {% endif %}
                                {% if don.ville %}
                                    <div>
                                        <dt class="text-xs font-medium text-navy-700">Ville</dt>
                                        <dd class="text-sm text-navy-900">{{ don.ville }}</dd>
                                    </div>
                                {% endif %}
                                {% if don.pays %}
                                    <div>
                                        <dt class="text-xs font-medium text-navy-700">Pays</dt>
                                        <dd class="text-sm text-navy-900">{{ don.pays }}</dd>
                                    </div>
                                {% endif %}
                            </dl>
                        </div>
                    </div>
                    
                    {% if don.message %}
                        <div class="mt-6 pt-6 border-t border-navy-200">
                            <h4 class="mb-2 text-sm font-semibold text-navy-700">Message du donateur</h4>
                            <div class="rounded-lg bg-navy-50 p-4">
                                <p class="text-sm text-navy-600 italic">{{ don.message }}</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        
        <div>
            <!-- Actions rapides -->
            <div class="card-modern mb-6">
                <div class="p-6">
                    <h3 class="mb-4 font-display text-xl font-bold text-navy-900">Actions</h3>
                    
                    <div class="space-y-3">
                        <a href="mailto:{{ don.email }}?subject=Votre don à HAKI YETU asbl (DON-{{ '%06d'|format(don.id) }})" 
                           class="flex items-center gap-3 rounded-lg border border-navy-300 bg-white px-4 py-3 text-sm font-medium text-navy-700 hover:bg-navy-50 transition-colors">
                            <i class="fas fa-envelope text-brand-700"></i>
                            <span>Envoyer un email</span>
                        </a>
                        
                        <button onclick="copyToClipboard('DON-{{ '%06d'|format(don.id) }}')" 
                                class="flex w-full items-center gap-3 rounded-lg border border-navy-300 bg-white px-4 py-3 text-sm font-medium text-navy-700 hover:bg-navy-50 transition-colors">
                            <i class="fas fa-copy text-brand-700"></i>
                            <span>Copier la référence</span>
                        </button>
                        
                        <a href="{{ path('app_don_edit', {'id': don.id}) }}" 
                           class="flex items-center gap-3 rounded-lg border border-navy-300 bg-white px-4 py-3 text-sm font-medium text-navy-700 hover:bg-navy-50 transition-colors">
                            <i class="fas fa-edit text-brand-700"></i>
                            <span>Modifier le don</span>
                        </a>
                        
                        <form action="{{ path('app_don_delete', {'id': don.id}) }}" method="post" 
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce don ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ don.id) }}">
                            <button type="submit" 
                                    class="flex w-full items-center gap-3 rounded-lg border border-red-300 bg-white px-4 py-3 text-sm font-medium text-red-700 hover:bg-red-50 transition-colors">
                                <i class="fas fa-trash text-red-600"></i>
                                <span>Supprimer le don</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
            <!-- Historique des statuts -->
            <div class="card-modern">
                <div class="p-6">
                    <h3 class="mb-4 font-display text-xl font-bold text-navy-900">Historique</h3>
                    
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-navy-700 text-xs font-bold text-white">
                                <i class="fas fa-plus"></i>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-navy-900">Don créé</p>
                                <p class="text-xs text-navy-600">{{ don.createdAt|date('d/m/Y à H:i') }}</p>
                            </div>
                        </div>
                        
                        {% if don.datePaiement %}
                            <div class="flex items-start gap-3">
                                <div class="flex h-6 w-6 items-center justify-center rounded-full bg-green-600 text-xs font-bold text-white">
                                    <i class="fas fa-check"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-navy-900">Don payé</p>
                                    <p class="text-xs text-navy-600">{{ don.datePaiement|date('d/m/Y à H:i') }}</p>
                                </div>
                            </div>
                        {% endif %}
                        
                        <div class="flex items-start gap-3">
                            <div class="flex h-6 w-6 items-center justify-center rounded-full {{ statut_couleurs[don.statut] }} text-xs font-bold">
                                <i class="fas fa-info"></i>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-navy-900">Statut actuel : {{ don.getStatutLabel() }}</p>
                                <p class="text-xs text-navy-600">Dernière mise à jour</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert('Référence copiée : ' + text);
        }, function(err) {
            console.error('Erreur lors de la copie : ', err);
        });
    }
</script>
{% endblock %}