{% extends 'base.html.twig' %}

{% block title %}Modifier le don #{{ don.id }} - HAKI YETU asbl{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8">
        <a href="{{ path('app_don_show', {'id': don.id}) }}" class="inline-flex items-center text-brand-700 hover:text-brand-800 mb-6">
            <i class="fas fa-arrow-left mr-2"></i> Retour au don
        </a>
        
        <div class="mb-6">
            <span class="section-eyebrow">Administration</span>
            <h1 class="mt-2 font-display text-3xl font-bold text-navy-900 md:text-4xl">Modifier le don #{{ '%06d'|format(don.id) }}</h1>
            <p class="mt-4 prose-body">
                Modifiez les informations de ce don. Les modifications seront enregistrées immédiatement.
            </p>
        </div>
    </div>
    
    <div class="card-modern">
        <div class="p-6 md:p-8">
            {{ form_start(form) }}
                <div class="space-y-6">
                    <!-- Informations du don -->
                    <div>
                        <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Informations du don</h2>
                        <div class="grid gap-4 md:grid-cols-2">
                            {{ form_row(form.montant) }}
                            {{ form_row(form.devise) }}
                            {{ form_row(form.typeDon) }}
                            {{ form_row(form.methodePaiement) }}
                            {{ form_row(form.statut) }}
                            {{ form_row(form.referencePaiement) }}
                            {{ form_row(form.urgence) }}
                        </div>
                    </div>
                    
                    <!-- Informations du donateur -->
                    <div>
                        <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Informations du donateur</h2>
                        <div class="space-y-4">
                            <div class="grid gap-4 md:grid-cols-2">
                                {{ form_row(form.typePersonne) }}
                                {{ form_row(form.nom) }}
                                {{ form_row(form.email) }}
                                {{ form_row(form.telephone) }}
                                {{ form_row(form.entreprise) }}
                            </div>
                            
                            <div class="grid gap-4 md:grid-cols-3">
                                {{ form_row(form.adresse) }}
                                {{ form_row(form.ville) }}
                                {{ form_row(form.pays) }}
                            </div>
                        </div>
                    </div>
                    
                    <!-- Options -->
                    <div>
                        <h2 class="mb-4 font-display text-xl font-bold text-navy-900">Options</h2>
                        <div class="space-y-4">
                            {{ form_row(form.message) }}
                            
                            <div class="grid gap-4 md:grid-cols-3">
                                {{ form_row(form.anonyme) }}
                                {{ form_row(form.receiptDemande) }}
                                {{ form_row(form.recevoirNewsletter) }}
                            </div>
                        </div>
                    </div>
                    
                    <div class="pt-6 border-t border-navy-200">
                        <div class="flex flex-col gap-4 sm:flex-row sm:justify-between">
                            <a href="{{ path('app_don_show', {'id': don.id}) }}" class="btn-secondary order-2 sm:order-1">
                                <i class="fas fa-times mr-2"></i> Annuler
                            </a>
                            <button type="submit" class="btn-primary order-1 sm:order-2">
                                <i class="fas fa-save mr-2"></i> Enregistrer les modifications
                            </button>
                        </div>
                    </div>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
    
    <div class="mt-8 rounded-xl bg-brand-50 border border-brand-200 p-6">
        <h3 class="mb-3 font-display text-lg font-bold text-brand-800">
            <i class="fas fa-exclamation-triangle mr-2"></i> À noter
        </h3>
        <ul class="space-y-2 text-sm text-brand-700">
            <li class="flex items-start gap-2">
                <i class="fas fa-info-circle mt-1"></i>
                <span>La modification du statut peut déclencher des emails automatiques au donateur</span>
            </li>
            <li class="flex items-start gap-2">
                <i class="fas fa-info-circle mt-1"></i>
                <span>La référence de paiement est importante pour le suivi bancaire</span>
            </li>
            <li class="flex items-start gap-2">
                <i class="fas fa-info-circle mt-1"></i>
                <span>Les modifications sont immédiatement visibles dans les rapports</span>
            </li>
        </ul>
    </div>
</div>
{% endblock %}