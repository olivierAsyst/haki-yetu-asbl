{% extends 'base.html.twig' %}

{% block title %}Faire un don - HAKI YETU asbl{% endblock %}

{% block meta_description %}Soutenez notre mission pour l'exclusion zéro des personnes vivant avec handicap. Faites un don à HAKI YETU asbl et contribuez à changer des vies.{% endblock %}

{% block og_title %}Faire un don - HAKI YETU asbl{% endblock %}
{% block og_description %}Soutenez notre mission pour l'exclusion zéro des personnes vivant avec handicap. Faites un don à HAKI YETU asbl et contribuez à changer des vies.{% endblock %}

{% block twitter_title %}Faire un don - HAKI YETU asbl{% endblock %}
{% block twitter_description %}Soutenez notre mission pour l'exclusion zéro des personnes vivant avec handicap. Faites un don à HAKI YETU asbl et contribuez à changer des vies.{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
        <!-- Colonne gauche: Carousel et formulaire -->
        <div class="lg:col-span-2">
            <div class="mb-10">
                <span class="section-eyebrow text-brand-600">Solidarité et impact</span>
                <h1 class="mt-2 font-display text-4xl font-bold text-navy-900 md:text-5xl">Faites un don</h1>
                <p class="mt-4 text-lg text-ink-900/80 leading-relaxed max-w-3xl">
                    Votre don permet de soutenir directement nos actions sur le terrain. 
                    Chaque contribution, quelle que soit sa taille, nous aide à poursuivre notre mission 
                    pour l'exclusion zéro des personnes vivant avec handicap.
                </p>
            </div>

            <!-- Carousel des images -->
            <div class="mb-10 rounded-2xl overflow-hidden shadow-lg">
                <div id="don-carousel" class="relative h-96">
                    <!-- Image 1 -->
                    <div class="absolute inset-0 transition-opacity duration-500 ease-in-out opacity-100" data-slide="0">
                        <div class="absolute inset-0 bg-gradient-to-r from-navy-900/70 to-transparent"></div>
                        <img src="https://images.unsplash.com/photo-1542159592-25df036c658b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                             alt="Enfants handicapés recevant une éducation inclusive" 
                             class="h-full w-full object-cover">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6">
                            <p class="text-white text-sm font-medium">Votre don soutient l'éducation inclusive pour les enfants handicapés</p>
                        </div>
                    </div>
                    <!-- Image 2 -->
                    <div class="absolute inset-0 transition-opacity duration-500 ease-in-out opacity-0" data-slide="1">
                        <div class="absolute inset-0 bg-gradient-to-r from-brand-900/70 to-transparent"></div>
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                             alt="Formation professionnelle pour personnes handicapées" 
                             class="h-full w-full object-cover">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6">
                            <p class="text-white text-sm font-medium">Votre don finance des formations professionnelles</p>
                        </div>
                    </div>
                    <!-- Image 3 -->
                    <div class="absolute inset-0 transition-opacity duration-500 ease-in-out opacity-0" data-slide="2">
                        <div class="absolute inset-0 bg-gradient-to-r from-sage-900/70 to-transparent"></div>
                        <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                             alt="Soutien médical et réadaptation" 
                             class="h-full w-full object-cover">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6">
                            <p class="text-white text-sm font-medium">Votre don permet l'accès aux soins et à la réadaptation</p>
                        </div>
                    </div>
                    
                    <!-- Contrôles du carousel -->
                    <button id="prev-slide" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-navy-900 p-2 rounded-full transition-colors">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button id="next-slide" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-navy-900 p-2 rounded-full transition-colors">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    
                    <!-- Indicateurs -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2">
                        <button class="w-3 h-3 rounded-full bg-white/80 hover:bg-white" data-slide-to="0"></button>
                        <button class="w-3 h-3 rounded-full bg-white/40 hover:bg-white/80" data-slide-to="1"></button>
                        <button class="w-3 h-3 rounded-full bg-white/40 hover:bg-white/80" data-slide-to="2"></button>
                    </div>
                </div>
            </div>

            <!-- Niveaux de dons et leur impact -->
            <div class="mb-10">
                <h2 class="font-display text-2xl font-bold text-navy-900 mb-6">Choisissez votre impact</h2>
                <div class="grid gap-6 md:grid-cols-3">
                    <div class="bg-gradient-to-b from-brand-50 to-white rounded-2xl border-2 border-brand-200 p-6 text-center">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-700 mx-auto mb-4">
                            <i class="fas fa-hands-helping text-xl"></i>
                        </div>
                        <h3 class="font-display text-xl font-bold text-navy-900 mb-2">Don Basique</h3>
                        <p class="text-3xl font-bold text-brand-700 mb-3">25 USD</p>
                        <p class="text-sm text-ink-900/70 mb-4 leading-relaxed">
                            Fournit un kit scolaire complet pour un enfant handicapé pendant 3 mois
                        </p>
                        <button type="button" data-montant="25" class="montant-btn-modern w-full">
                            Donner 25 USD
                        </button>
                    </div>
                    
                    <div class="bg-gradient-to-b from-brand-100 to-white rounded-2xl border-2 border-brand-400 p-6 text-center shadow-lg relative">
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                            <span class="inline-flex items-center rounded-full bg-brand-600 px-4 py-1.5 text-xs font-semibold text-white">
                                <i class="fas fa-star mr-1.5"></i> Populaire
                            </span>
                        </div>
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-200 text-brand-800 mx-auto mb-4">
                            <i class="fas fa-heart text-xl"></i>
                        </div>
                        <h3 class="font-display text-xl font-bold text-navy-900 mb-2">Don Standard</h3>
                        <p class="text-3xl font-bold text-brand-800 mb-3">50 USD</p>
                        <p class="text-sm text-ink-900/70 mb-4 leading-relaxed">
                            Finance une formation professionnelle d'une semaine pour une personne handicapée
                        </p>
                        <button type="button" data-montant="50" class="montant-btn-modern w-full active">
                            Donner 50 USD
                        </button>
                    </div>
                    
                    <div class="bg-gradient-to-b from-navy-50 to-white rounded-2xl border-2 border-navy-200 p-6 text-center">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-navy-100 text-navy-700 mx-auto mb-4">
                            <i class="fas fa-star text-xl"></i>
                        </div>
                        <h3 class="font-display text-xl font-bold text-navy-900 mb-2">Don Premium</h3>
                        <p class="text-3xl font-bold text-navy-700 mb-3">100 USD</p>
                        <p class="text-sm text-ink-900/70 mb-4 leading-relaxed">
                            Offre un micro-crédit pour démarrer une activité génératrice de revenus
                        </p>
                        <button type="button" data-montant="100" class="montant-btn-modern w-full">
                            Donner 100 USD
                        </button>
                    </div>
                </div>
            </div>

            <!-- Formulaire de don -->
            <div class="form-card-modern">
                <h2 class="font-display text-2xl font-bold text-navy-900 mb-8">Formulaire de don</h2>
                
                {{ form_start(form, {'attr': {'class': 'space-y-10', 'id': 'don-form'}}) }}
                {{ include('_form_errors_globales.html.twig') }}
                {% if urgence %}
                    <div class="rounded-lg border border-brand-700/30 bg-brand-700/10 px-4 py-3 text-sm text-brand-800">
                        <i class="fas fa-hand-holding-heart mr-2" aria-hidden="true"></i>
                        Votre don soutient l'appel d'urgence <strong>« {{ urgence.titre }} »</strong> ({{ urgence.lieu }}).
                        Les dons en francs congolais (CDF) sont ajoutés au montant collecté dès réception du paiement.
                    </div>
                {% endif %}
                    <!-- Informations personnelles -->
                    <div class="form-section-modern">
                        <div class="form-section-header">
                            <div class="form-section-number">1</div>
                            <h3 class="form-section-title">Informations personnelles</h3>
                        </div>
                        
                        <div class="space-y-6">
                            <!-- Type de personne - Radio boutons améliorés -->
                            <div class="form-group-modern">
                                <label class="form-label-modern">Je suis un(e)</label>
                                <div class="radio-group-inline">
                                    {% for child in form.typePersonne %}
                                        {{ form_widget(child, {'attr': {'class': 'form-radio-modern'}}) }}
                                        {{ form_label(child, null, {
                                            'label_attr': {
                                                'class': 'inline-flex items-center gap-3'
                                            }
                                        }) }}
                                    {% endfor %}
                                </div>
                            </div>
                            
                            <!-- Nom et email -->
                            <div class="grid gap-6 md:grid-cols-2">
                                <div class="form-group-modern">
                                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    {{ form_widget(form.nom, {'attr': {'class': 'form-input-modern', 'placeholder': 'Ex: Jean Dupont'}}) }}
                                </div>
                                
                                <div class="form-group-modern">
                                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    {{ form_widget(form.email, {'attr': {'class': 'form-input-modern', 'placeholder': 'exemple@email.com'}}) }}
                                </div>
                            </div>
                            
                            <!-- Téléphone -->
                            <div class="form-group-modern">
                                {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                {{ form_widget(form.telephone, {'attr': {'class': 'form-input-modern', 'placeholder': '+243 99 123 4567'}}) }}
                            </div>
                            
                            <!-- Champs entreprise (caché par défaut) -->
                            <div id="entreprise-fields" class="hidden form-group-modern">
                                {{ form_label(form.entreprise, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                {{ form_widget(form.entreprise, {'attr': {'class': 'form-input-modern', 'placeholder': 'Ex: Société ABC'}}) }}
                            </div>
                            
                            <!-- Adresse -->
                            <div class="grid gap-6 md:grid-cols-3">
                                <div class="form-group-modern">
                                    {{ form_label(form.adresse, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    {{ form_widget(form.adresse, {'attr': {'class': 'form-input-modern', 'placeholder': 'Ex: Av. du Congo, N°68'}}) }}
                                </div>
                                
                                <div class="form-group-modern">
                                    {{ form_label(form.ville, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    {{ form_widget(form.ville, {'attr': {'class': 'form-input-modern', 'placeholder': 'Ex: Uvira'}}) }}
                                </div>
                                
                                <div class="form-group-modern">
                                    {{ form_label(form.pays, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    {{ form_widget(form.pays, {'attr': {'class': 'form-input-modern', 'placeholder': 'Ex: RD Congo'}}) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Montant du don -->
                    <div class="form-section-modern">
                        <div class="form-section-header">
                            <div class="form-section-number">2</div>
                            <h3 class="form-section-title">Montant du don</h3>
                        </div>
                        
                        <div class="space-y-6">
                            <!-- Type de don - Select amélioré -->
                            <div class="form-group-modern">
                                {{ form_label(form.typeDon, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                <div class="relative">
                                    <i class="fas fa-gift absolute left-4 top-1/2 -translate-y-1/2 text-navy-500"></i>
                                    {{ form_widget(form.typeDon, {'attr': {'class': 'form-select-modern pl-12'}}) }}
                                </div>
                            </div>
                            
                            <!-- Montant et devise -->
                            <div class="grid gap-6 md:grid-cols-2">
                                <div class="form-group-modern">
                                    {{ form_label(form.montant, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    <div class="relative">
                                        <i class="fas fa-money-bill-wave absolute left-4 top-1/2 -translate-y-1/2 text-navy-500"></i>
                                        {{ form_widget(form.montant, {'attr': {'class': 'form-input-modern pl-12', 'placeholder': '50.00'}}) }}
                                    </div>
                                    <p class="form-help-text">Le montant minimum est de 1 USD</p>
                                </div>
                                
                                <div class="form-group-modern">
                                    {{ form_label(form.devise, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                    <div class="relative">
                                        <i class="fas fa-globe absolute left-4 top-1/2 -translate-y-1/2 text-navy-500"></i>
                                        {{ form_widget(form.devise, {'attr': {'class': 'form-select-modern pl-12'}}) }}
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Montants suggérés -->
                            <div class="form-group-modern">
                                <label class="form-label-modern">Montants suggérés :</label>
                                <div class="flex flex-wrap gap-3">
                                    {# Montants adaptés à la devise : CDF pour un appel d'urgence, USD sinon #}
                                    {% set devise_suggestion = urgence ? 'CDF' : 'USD' %}
                                    {% set montants = urgence ? [10000, 25000, 50000, 100000, 250000, 500000] : [10, 25, 50, 100, 250, 500] %}
                                    {% for montant in montants %}
                                        <button type="button"
                                                class="montant-btn-modern {{ (form.montant.vars.value ?: 50) == montant ? 'active' : '' }}"
                                                data-montant="{{ montant }}">
                                            {{ montant|number_format(0, ',', ' ') }} {{ devise_suggestion }}
                                        </button>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Méthode de paiement -->
                    <div class="form-section-modern">
                        <div class="form-section-header">
                            <div class="form-section-number">3</div>
                            <h3 class="form-section-title">Méthode de paiement</h3>
                        </div>
                        
                        <div class="space-y-6">
                            <div class="form-group-modern">
                                {{ form_label(form.methodePaiement, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                <div class="relative">
                                    <i class="fas fa-credit-card absolute left-4 top-1/2 -translate-y-1/2 text-navy-500"></i>
                                    {{ form_widget(form.methodePaiement, {'attr': {'class': 'form-select-modern pl-12'}}) }}
                                </div>
                            </div>
                            
                            <div id="instructions-paiement" class="hidden rounded-2xl bg-gradient-to-r from-brand-50 to-white p-6 border border-brand-200">
                                <h4 class="font-display text-lg font-bold text-navy-900 mb-4">Instructions de paiement :</h4>
                                <div class="space-y-4 text-sm text-navy-700">
                                    <div id="instructions-mobile" class="hidden">
                                        <div class="flex items-start gap-3">
                                            <i class="fas fa-mobile-alt text-brand-600 mt-1"></i>
                                            <div>
                                                <p class="font-semibold">Mobile Money</p>
                                                <p class="mt-1"><strong>Orange Money:</strong> +243 994 116 041</p>
                                                <p><strong>Airtel Money:</strong> +243 999 644 524</p>
                                                <p><strong>M-Pesa:</strong> +243 810 000 000</p>
                                                <p class="mt-2 text-xs text-navy-600"><em>Veuillez indiquer "Don HAKI YETU" dans le message</em></p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div id="instructions-bancaire" class="hidden">
                                        <div class="flex items-start gap-3">
                                            <i class="fas fa-university text-brand-600 mt-1"></i>
                                            <div>
                                                <p class="font-semibold">Virement bancaire</p>
                                                <p class="mt-1"><strong>Banque:</strong> Banque Commerciale du Congo</p>
                                                <p><strong>Nom du compte:</strong> HAKI YETU asbl</p>
                                                <p><strong>Numéro de compte:</strong> 123-456-789-0</p>
                                                <p><strong>IBAN:</strong> CD12345678901234567890</p>
                                                <p><strong>Swift/BIC:</strong> BCDC CD KI</p>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div id="instructions-western" class="hidden">
                                        <div class="flex items-start gap-3">
                                            <i class="fas fa-exchange-alt text-brand-600 mt-1"></i>
                                            <div>
                                                <p class="font-semibold">Western Union / MoneyGram</p>
                                                <p class="mt-1"><strong>Bénéficiaire:</strong> HAKI YETU asbl</p>
                                                <p><strong>Ville:</strong> Uvira, Sud-Kivu</p>
                                                <p><strong>Pays:</strong> République Démocratique du Congo</p>
                                                <p><strong>Téléphone:</strong> +243 994 116 041</p>
                                                <p><strong>Adresse:</strong> Qt Kimanga, Av du Congo, N°68</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Options supplémentaires -->
                    <div class="form-section-modern">
                        <div class="form-section-header">
                            <div class="form-section-number">4</div>
                            <h3 class="form-section-title">Options supplémentaires</h3>
                        </div>
                        
                        <div class="space-y-6">
                            <!-- Message -->
                            <div class="form-group-modern">
                                {{ form_label(form.message, null, {'label_attr': {'class': 'form-label-modern'}}) }}
                                {{ form_widget(form.message, {'attr': {'class': 'form-input-modern min-h-[120px]', 'placeholder': 'Un message pour l\'équipe de HAKI YETU...', 'rows': 4}}) }}
                            </div>
                            
                            <!-- Checkboxes améliorées -->
                            <div class="space-y-4">
                                <div class="flex items-start gap-3">
                                    {{ form_widget(form.anonyme, {'attr': {'class': 'form-checkbox-modern mt-1'}}) }}
                                    <div>
                                        {{ form_label(form.anonyme, null, {'label_attr': {'class': 'text-sm font-medium text-navy-900 cursor-pointer'}}) }}
                                        <p class="text-xs text-navy-600 mt-1">Votre nom n'apparaîtra pas dans nos publications</p>
                                    </div>
                                </div>
                                
                                <div class="flex items-start gap-3">
                                    {{ form_widget(form.receiptDemande, {'attr': {'class': 'form-checkbox-modern mt-1'}}) }}
                                    <div>
                                        {{ form_label(form.receiptDemande, null, {'label_attr': {'class': 'text-sm font-medium text-navy-900 cursor-pointer'}}) }}
                                        <p class="text-xs text-navy-600 mt-1">Pour déduction fiscale selon la législation en vigueur</p>
                                    </div>
                                </div>
                                
                                <div class="flex items-start gap-3">
                                    {{ form_widget(form.recevoirNewsletter, {'attr': {'class': 'form-checkbox-modern mt-1'}}) }}
                                    <div>
                                        {{ form_label(form.recevoirNewsletter, null, {'label_attr': {'class': 'text-sm font-medium text-navy-900 cursor-pointer'}}) }}
                                        <p class="text-xs text-navy-600 mt-1">Recevez nos actualités et rapports d'impact</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Bouton de soumission -->
                    <div class="pt-8 border-t border-navy-200">
                        <button type="submit" class="btn-humanitarian w-full py-4 text-lg font-semibold">
                            <i class="fas fa-heart mr-3"></i> Faire mon don maintenant
                        </button>
                        <p class="mt-4 text-center text-sm text-navy-600">
                            <i class="fas fa-lock mr-1.5"></i> Vos informations sont sécurisées et confidentielles
                        </p>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        <!-- Colonne droite: Informations complémentaires -->
        <div class="space-y-8">
            <!-- Statistiques -->
            <div class="rounded-2xl bg-gradient-to-br from-navy-900 to-navy-800 p-6 text-white shadow-lg">
                <h3 class="font-display text-xl font-bold mb-6">Impact de vos dons</h3>
                <div class="space-y-5">
                    <div class="flex items-center gap-4 p-4 rounded-xl bg-white/10 hover:bg-white/15 transition-colors">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm">
                            <i class="fas fa-users text-xl"></i>
                        </div>
                        <div>
                            <p class="text-2xl font-bold">500+</p>
                            <p class="text-sm text-brand-100/80">Bénéficiaires directs</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 p-4 rounded-xl bg-white/10 hover:bg-white/15 transition-colors">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm">
                            <i class="fas fa-project-diagram text-xl"></i>
                        </div>
                        <div>
                            <p class="text-2xl font-bold">12+</p>
                            <p class="text-sm text-brand-100/80">Projets financés</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 p-4 rounded-xl bg-white/10 hover:bg-white/15 transition-colors">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm">
                            <i class="fas fa-chart-line text-xl"></i>
                        </div>
                        <div>
                            <p class="text-2xl font-bold">100%</p>
                            <p class="text-sm text-brand-100/80">Transparence</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pourquoi donner -->
            <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-white p-6 border border-brand-200 shadow-sm">
                <h3 class="font-display text-xl font-bold text-navy-900 mb-5">Pourquoi donner ?</h3>
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1 flex-shrink-0">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70 leading-relaxed">100% de votre don est utilisé sur le terrain</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1 flex-shrink-0">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70 leading-relaxed">Reçu fiscal disponible pour déduction</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1 flex-shrink-0">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70 leading-relaxed">Rapports réguliers sur l'utilisation des fonds</span>
                    </li>
                    <li class="flex items-start gap-3">
