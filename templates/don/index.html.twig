{% extends 'base.html.twig' %}

{% block title %}Faire un don - HAKI YETU asbl{% endblock %}

{% block meta_description %}Soutenez notre mission pour l'exclusion zéro des personnes vivant avec handicap. Faites un don à HAKI YETU asbl et contribuez à changer des vies.{% endblock %}

{% block og_title %}Faire un don - HAKI YETU asbl{% endblock %}
{% block og_description %}Soutenez notre mission pour l'exclusion zéro des personnes vivant avec handicap. Faites un don à HAKI YETU asbl et contribuez à changer des vies.{% endblock %}

{% block twitter_title %}Faire un don - HAKI YETU asbl{% endblock %}
{% block twitter_description %}Soutenez notre mission pour l'exclusion zéro des personnes vivant avec handicap. Faites un don à HAKI YETU asbl et contribuez à changer des vies.{% endblock %}

{% block body %}
<div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-3">
        <!-- Colonne gauche: Carousel et formulaire -->
        <div class="lg:col-span-2">
            <div class="mb-10">
                <span class="section-eyebrow text-brand-600">Solidarité et impact</span>
                <h1 class="mt-2 font-display text-4xl font-bold text-navy-900 md:text-5xl">Faites un don</h1>
                <p class="mt-4 text-lg text-ink-900/80 leading-relaxed max-w-3xl">
                    Votre don permet de soutenir directement nos actions sur le terrain. 
                    Chaque contribution, quelle que soit sa taille, nous aide à poursuivre notre mission 
                    pour l'exclusion zéro des personnes vivant avec handicap.
                </p>
            </div>

            <!-- Carousel des images -->
            <div class="mb-10 rounded-2xl overflow-hidden shadow-lg">
                <div id="don-carousel" class="relative h-96">
                    <!-- Image 1 -->
                    <div class="absolute inset-0 transition-opacity duration-500 ease-in-out opacity-100" data-slide="0">
                        <div class="absolute inset-0 bg-gradient-to-r from-navy-900/70 to-transparent"></div>
                        <img src="https://images.unsplash.com/photo-1542159592-25df036c658b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                             alt="Enfants handicapés recevant une éducation inclusive" 
                             class="h-full w-full object-cover">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6">
                            <p class="text-white text-sm font-medium">Votre don soutient l'éducation inclusive pour les enfants handicapés</p>
                        </div>
                    </div>
                    <!-- Image 2 -->
                    <div class="absolute inset-0 transition-opacity duration-500 ease-in-out opacity-0" data-slide="1">
                        <div class="absolute inset-0 bg-gradient-to-r from-brand-900/70 to-transparent"></div>
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                             alt="Formation professionnelle pour personnes handicapées" 
                             class="h-full w-full object-cover">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6">
                            <p class="text-white text-sm font-medium">Votre don finance des formations professionnelles</p>
                        </div>
                    </div>
                    <!-- Image 3 -->
                    <div class="absolute inset-0 transition-opacity duration-500 ease-in-out opacity-0" data-slide="2">
                        <div class="absolute inset-0 bg-gradient-to-r from-sage-900/70 to-transparent"></div>
                        <img src="https://images.unsplash.com/photo-1517048676732-d65bc937f952?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80" 
                             alt="Soutien médical et réadaptation" 
                             class="h-full w-full object-cover">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-6">
                            <p class="text-white text-sm font-medium">Votre don permet l'accès aux soins et à la réadaptation</p>
                        </div>
                    </div>
                    
                    <!-- Contrôles du carousel -->
                    <button id="prev-slide" class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-navy-900 p-2 rounded-full transition-colors">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button id="next-slide" class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 hover:bg-white text-navy-900 p-2 rounded-full transition-colors">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                    
                    <!-- Indicateurs -->
                    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex space-x-2">
                        <button class="w-3 h-3 rounded-full bg-white/80 hover:bg-white" data-slide-to="0"></button>
                        <button class="w-3 h-3 rounded-full bg-white/40 hover:bg-white/80" data-slide-to="1"></button>
                        <button class="w-3 h-3 rounded-full bg-white/40 hover:bg-white/80" data-slide-to="2"></button>
                    </div>
                </div>
            </div>

            <!-- Niveaux de dons et leur impact -->
            <div class="mb-10">
                <h2 class="font-display text-2xl font-bold text-navy-900 mb-6">Choisissez votre impact</h2>
                <div class="grid gap-6 md:grid-cols-3">
                    <div class="bg-gradient-to-b from-brand-50 to-white rounded-xl border-2 border-brand-200 p-6 text-center">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-brand-700 mx-auto mb-4">
                            <i class="fas fa-hands-helping text-xl"></i>
                        </div>
                        <h3 class="font-display text-xl font-bold text-navy-900 mb-2">Don Basique</h3>
                        <p class="text-3xl font-bold text-brand-700 mb-3">25 USD</p>
                        <p class="text-sm text-ink-900/70 mb-4">
                            Fournit un kit scolaire complet pour un enfant handicapé pendant 3 mois
                        </p>
                        <button type="button" data-montant="25" class="w-full rounded-lg bg-brand-100 text-brand-700 px-4 py-2.5 text-sm font-semibold hover:bg-brand-200 transition-colors">
                            Donner 25 USD
                        </button>
                    </div>
                    
                    <div class="bg-gradient-to-b from-brand-100 to-white rounded-xl border-2 border-brand-400 p-6 text-center shadow-md">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-200 text-brand-800 mx-auto mb-4">
                            <i class="fas fa-heart text-xl"></i>
                        </div>
                        <h3 class="font-display text-xl font-bold text-navy-900 mb-2">Don Standard</h3>
                        <p class="text-3xl font-bold text-brand-800 mb-3">50 USD</p>
                        <p class="text-sm text-ink-900/70 mb-4">
                            Finance une formation professionnelle d'une semaine pour une personne handicapée
                        </p>
                        <button type="button" data-montant="50" class="w-full rounded-lg bg-brand-700 text-white px-4 py-2.5 text-sm font-semibold hover:bg-brand-800 transition-colors">
                            Donner 50 USD
                        </button>
                    </div>
                    
                    <div class="bg-gradient-to-b from-navy-50 to-white rounded-xl border-2 border-navy-200 p-6 text-center">
                        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-navy-100 text-navy-700 mx-auto mb-4">
                            <i class="fas fa-star text-xl"></i>
                        </div>
                        <h3 class="font-display text-xl font-bold text-navy-900 mb-2">Don Premium</h3>
                        <p class="text-3xl font-bold text-navy-700 mb-3">100 USD</p>
                        <p class="text-sm text-ink-900/70 mb-4">
                            Offre un micro-crédit pour démarrer une activité génératrice de revenus
                        </p>
                        <button type="button" data-montant="100" class="w-full rounded-lg bg-navy-700 text-white px-4 py-2.5 text-sm font-semibold hover:bg-navy-800 transition-colors">
                            Donner 100 USD
                        </button>
                    </div>
                </div>
            </div>

            <!-- Formulaire de don -->
            <div class="bg-white rounded-2xl border border-brand-200 p-8 shadow-sm">
                <h2 class="font-display text-2xl font-bold text-navy-900 mb-6">Formulaire de don</h2>
                
                {{ form_start(form, {'attr': {'class': 'space-y-8', 'id': 'don-form'}}) }}
                    <div class="space-y-6">
                        <!-- Informations personnelles -->
                        <div>
                            <h3 class="mb-4 flex items-center font-display text-xl font-bold text-navy-900">
                                <span class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">1</span>
                                Informations personnelles
                            </h3>
                            <div class="space-y-4">
                                {{ form_row(form.typePersonne) }}
                                {{ form_row(form.nom) }}
                                {{ form_row(form.email) }}
                                {{ form_row(form.telephone) }}
                                
                                <div id="entreprise-fields" class="hidden space-y-4">
                                    {{ form_row(form.entreprise) }}
                                </div>
                                
                                <div class="grid gap-4 md:grid-cols-2">
                                    {{ form_row(form.adresse) }}
                                    {{ form_row(form.ville) }}
                                    {{ form_row(form.pays) }}
                                </div>
                            </div>
                        </div>

                        <!-- Montant du don -->
                        <div>
                            <h3 class="mb-4 flex items-center font-display text-xl font-bold text-navy-900">
                                <span class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">2</span>
                                Montant du don
                            </h3>
                            <div class="space-y-4">
                                {{ form_row(form.typeDon) }}
                                
                                <div class="grid gap-4 md:grid-cols-2">
                                    {{ form_row(form.montant) }}
                                    {{ form_row(form.devise) }}
                                </div>
                                
                                <!-- Montants suggérés -->
                                <div class="mt-4">
                                    <p class="mb-3 text-sm font-medium text-navy-700">Montants suggérés :</p>
                                    <div class="flex flex-wrap gap-2">
                                        {% set montants = [10, 25, 50, 100, 250, 500] %}
                                        {% for montant in montants %}
                                            <button type="button" 
                                                    class="montant-btn rounded-lg border-2 border-navy-300 px-4 py-2 text-sm font-medium text-navy-700 transition-all duration-300 hover:border-brand-700 hover:bg-brand-50 hover:text-brand-700"
                                                    data-montant="{{ montant }}">
                                                {{ montant }} USD
                                            </button>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Méthode de paiement -->
                        <div>
                            <h3 class="mb-4 flex items-center font-display text-xl font-bold text-navy-900">
                                <span class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">3</span>
                                Méthode de paiement
                            </h3>
                            <div class="space-y-4">
                                {{ form_row(form.methodePaiement) }}
                                
                                <div id="instructions-paiement" class="hidden rounded-xl bg-navy-50 p-4">
                                    <h4 class="mb-2 font-display text-lg font-bold text-navy-900">Instructions de paiement :</h4>
                                    <div class="space-y-3 text-sm text-navy-600">
                                        <p id="instructions-mobile" class="hidden">
                                            <!-- Les instructions seront remplies par JavaScript -->
                                        </p>
                                        <p id="instructions-bancaire" class="hidden">
                                            <!-- Les instructions seront remplies par JavaScript -->
                                        </p>
                                        <p id="instructions-western" class="hidden">
                                            <!-- Les instructions seront remplies par JavaScript -->
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Options supplémentaires -->
                        <div>
                            <h3 class="mb-4 flex items-center font-display text-xl font-bold text-navy-900">
                                <span class="mr-3 flex h-8 w-8 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">4</span>
                                Options supplémentaires
                            </h3>
                            <div class="space-y-4">
                                {{ form_row(form.message) }}
                                {{ form_row(form.anonyme) }}
                                {{ form_row(form.receiptDemande) }}
                                {{ form_row(form.recevoirNewsletter) }}
                            </div>
                        </div>

                        <!-- Bouton de soumission -->
                        <div class="pt-6 border-t border-navy-200">
                            <button type="submit" class="btn-humanitarian w-full py-4 text-lg">
                                <i class="fas fa-heart mr-2"></i> Faire mon don maintenant
                            </button>
                        </div>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>

        <!-- Colonne droite: Informations complémentaires -->
        <div class="space-y-8">
            <!-- Statistiques -->
            <div class="rounded-2xl bg-gradient-to-br from-navy-900 to-navy-800 p-6 text-white">
                <h3 class="font-display text-xl font-bold mb-6">Impact de vos dons</h3>
                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-2xl font-bold">500+</p>
                            <p class="text-sm text-brand-100/80">Bénéficiaires directs</p>
                        </div>
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/20">
                            <i class="fas fa-users"></i>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-2xl font-bold">12+</p>
                            <p class="text-sm text-brand-100/80">Projets financés</p>
                        </div>
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/20">
                            <i class="fas fa-project-diagram"></i>
                        </div>
                    </div>
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-2xl font-bold">100%</p>
                            <p class="text-sm text-brand-100/80">Transparence</p>
                        </div>
                        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-white/20">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pourquoi donner -->
            <div class="rounded-2xl bg-gradient-to-br from-brand-50 to-white p-6 border border-brand-200">
                <h3 class="font-display text-xl font-bold text-navy-900 mb-4">Pourquoi donner ?</h3>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70">100% de votre don est utilisé sur le terrain</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70">Reçu fiscal disponible pour déduction</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70">Rapports réguliers sur l'utilisation des fonds</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 mt-1">
                            <i class="fas fa-check text-xs"></i>
                        </div>
                        <span class="text-sm text-ink-900/70">Impact mesurable et concret</span>
                    </li>
                </ul>
            </div>

            <!-- Contact -->
            <div class="rounded-2xl bg-white p-6 border border-navy-200">
                <h3 class="font-display text-xl font-bold text-navy-900 mb-4">Questions ?</h3>
                <p class="text-sm text-ink-900/70 mb-4">
                    Notre équipe est à votre disposition pour toute question concernant votre don.
                </p>
                <div class="space-y-3">
                    <a href="tel:+243994116041" class="flex items-center gap-3 text-sm text-navy-700 hover:text-brand-700 transition-colors">
                        <i class="fas fa-phone text-brand-700"></i>
                        <span>+243 994 116 041</span>
                    </a>
                    <a href="mailto:hakiyetuass@yahoo.fr" class="flex items-center gap-3 text-sm text-navy-700 hover:text-brand-700 transition-colors">
                        <i class="fas fa-envelope text-brand-700"></i>
                        <span>hakiyetuass@yahoo.fr</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Carousel
    const slides = document.querySelectorAll('#don-carousel > div[data-slide]');
    const slideIndicators = document.querySelectorAll('#don-carousel [data-slide-to]');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');
    let currentSlide = 0;
    
    function showSlide(index) {
        slides.forEach((slide, i) => {
            slide.style.opacity = i === index ? '1' : '0';
            slideIndicators[i].classList.toggle('bg-white/80', i === index);
            slideIndicators[i].classList.toggle('bg-white/40', i !== index);
        });
        currentSlide = index;
    }
    
    prevBtn.addEventListener('click', () => {
        showSlide((currentSlide - 1 + slides.length) % slides.length);
    });
    
    nextBtn.addEventListener('click', () => {
        showSlide((currentSlide + 1) % slides.length);
    });
    
    slideIndicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => showSlide(index));
    });
    
    // Auto-rotation du carousel
    setInterval(() => {
        showSlide((currentSlide + 1) % slides.length);
    }, 5000);
    
    // Boutons de montants
    const montantBtns = document.querySelectorAll('.montant-btn, [data-montant]');
    const montantInput = document.querySelector('input[name="don[montant]"]');
    
    montantBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const montant = this.getAttribute('data-montant');
            montantInput.value = montant;
            
            // Mettre en évidence le bouton sélectionné
            montantBtns.forEach(b => {
                b.classList.remove('bg-brand-700', 'text-white', 'border-brand-700');
                b.classList.add('border-navy-300', 'text-navy-700');
            });
            
            this.classList.remove('border-navy-300', 'text-navy-700');
            this.classList.add('bg-brand-700', 'text-white', 'border-brand-700');
        });
    });
    
    // Gestion du type de personne
    const typePersonneSelect = document.querySelector('select[name="don[typePersonne]"]');
    const entrepriseFields = document.getElementById('entreprise-fields');
    
    if (typePersonneSelect) {
        typePersonneSelect.addEventListener('change', function() {
            if (this.value === 'entreprise') {
                entrepriseFields.classList.remove('hidden');
            } else {
                entrepriseFields.classList.add('hidden');
            }
        });
    }
    
    // Gestion des méthodes de paiement
    const methodePaiementSelect = document.querySelector('select[name="don[methodePaiement]"]');
    const instructionsPaiement = document.getElementById('instructions-paiement');
    
    if (methodePaiementSelect) {
        methodePaiementSelect.addEventListener('change', function() {
            const instructionsMobile = document.getElementById('instructions-mobile');
            const instructionsBancaire = document.getElementById('instructions-bancaire');
            const instructionsWestern = document.getElementById('instructions-western');
            
            instructionsMobile.classList.add('hidden');
            instructionsBancaire.classList.add('hidden');
            instructionsWestern.classList.add('hidden');
            
            instructionsPaiement.classList.remove('hidden');
            
            switch(this.value) {
                case 'mobile_money':
                    instructionsMobile.classList.remove('hidden');
                    instructionsMobile.innerHTML = `
                        <p><strong>Orange Money:</strong> +243 994 116 041</p>
                        <p><strong>Airtel Money:</strong> +243 999 644 524</p>
                        <p><strong>M-Pesa:</strong> +243 810 000 000</p>
                        <p class="mt-2"><em>Veuillez indiquer "Don HAKI YETU" dans le message</em></p>
                    `;
                    break;
                case 'virement_bancaire':
                    instructionsBancaire.classList.remove('hidden');
                    instructionsBancaire.innerHTML = `
                        <p><strong>Banque:</strong> Banque Commerciale du Congo</p>
                        <p><strong>Nom du compte:</strong> HAKI YETU asbl</p>
                        <p><strong>Numéro de compte:</strong> 123-456-789-0</p>
                        <p><strong>IBAN:</strong> CD12345678901234567890</p>
                        <p><strong>Swift/BIC:</strong> BCDC CD KI</p>
                    `;
                    break;
                case 'western_union':
                    instructionsWestern.classList.remove('hidden');
                    instructionsWestern.innerHTML = `
                        <p><strong>Bénéficiaire:</strong> HAKI YETU asbl</p>
                        <p><strong>Ville:</strong> Uvira, Sud-Kivu</p>
                        <p><strong>Pays:</strong> République Démocratique du Congo</p>
                        <p><strong>Téléphone:</strong> +243 994 116 041</p>
                        <p><strong>Adresse:</strong> Qt Kimanga, Av du Congo, N°68</p>
                    `;
                    break;
            }
        });
    }
});
</script>
{% endblock %}