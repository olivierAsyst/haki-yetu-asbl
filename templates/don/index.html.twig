<script>
document.addEventListener('DOMContentLoaded', function() {
    // Carousel
    const slides = document.querySelectorAll('#don-carousel > div[data-slide]');
    const slideIndicators = document.querySelectorAll('#don-carousel [data-slide-to]');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');
    let currentSlide = 0;
    
    function showSlide(index) {
        slides.forEach((slide, i) => {
            slide.style.opacity = i === index ? '1' : '0';
            slideIndicators[i].classList.toggle('bg-white/80', i === index);
            slideIndicators[i].classList.toggle('bg-white/40', i !== index);
        });
        currentSlide = index;
    }
    
    prevBtn.addEventListener('click', () => {
        showSlide((currentSlide - 1 + slides.length) % slides.length);
    });
    
    nextBtn.addEventListener('click', () => {
        showSlide((currentSlide + 1) % slides.length);
    });
    
    slideIndicators.forEach((indicator, index) => {
        indicator.addEventListener('click', () => showSlide(index));
    });
    
    // Auto-rotation du carousel
    setInterval(() => {
        showSlide((currentSlide + 1) % slides.length);
    }, 5000);
    
    // Boutons de montants
    const montantBtns = document.querySelectorAll('.montant-btn-modern');
    const montantInput = document.querySelector('input[name="don[montant]"]');
    
    montantBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const montant = this.getAttribute('data-montant');
            montantInput.value = montant;
            
            // Mettre en évidence le bouton sélectionné
            montantBtns.forEach(b => {
                b.classList.remove('active');
            });
            
            this.classList.add('active');
        });
    });
    
    // Gestion du type de personne
    const typePersonneRadios = document.querySelectorAll('input[name="don[typePersonne]"]');
    const entrepriseFields = document.getElementById('entreprise-fields');
    
    typePersonneRadios.forEach(radio => {
        radio.addEventListener('change', function() {
            if (this.value === 'entreprise') {
                entrepriseFields.classList.remove('hidden');
                entrepriseFields.classList.add('block');
            } else {
                entrepriseFields.classList.remove('block');
                entrepriseFields.classList.add('hidden');
            }
        });
    });
    
    // Initialiser l'état du champ entreprise
    const selectedType = document.querySelector('input[name="don[typePersonne]"]:checked');
    if (selectedType && selectedType.value === 'entreprise') {
        entrepriseFields.classList.remove('hidden');
        entrepriseFields.classList.add('block');
    }
    
    // Gestion des méthodes de paiement
    const methodePaiementSelect = document.querySelector('select[name="don[methodePaiement]"]');
    const instructionsPaiement = document.getElementById('instructions-paiement');
    
    if (methodePaiementSelect) {
        methodePaiementSelect.addEventListener('change', function() {
            const instructionsMobile = document.getElementById('instructions-mobile');
            const instructionsBancaire = document.getElementById('instructions-bancaire');
            const instructionsWestern = document.getElementById('instructions-western');
            
            instructionsMobile.classList.add('hidden');
            instructionsBancaire.classList.add('hidden');
            instructionsWestern.classList.add('hidden');
            
            if (this.value) {
                instructionsPaiement.classList.remove('hidden');
                instructionsPaiement.classList.add('block');
                
                switch(this.value) {
                    case 'mobile_money':
                        instructionsMobile.classList.remove('hidden');
                        instructionsMobile.classList.add('block');
                        break;
                    case 'virement_bancaire':
                        instructionsBancaire.classList.remove('hidden');
                        instructionsBancaire.classList.add('block');
                        break;
                    case 'western_union':
                    case 'moneygram':
                        instructionsWestern.classList.remove('hidden');
                        instructionsWestern.classList.add('block');
                        // Ajuster le titre selon la méthode
                        const title = this.value === 'western_union' ? 'Western Union' : 'MoneyGram';
                        instructionsWestern.querySelector('.font-semibold').textContent = title + ' / ' + (this.value === 'western_union' ? 'MoneyGram' : 'Western Union');
                        break;
                    default:
                        instructionsPaiement.classList.remove('block');
                        instructionsPaiement.classList.add('hidden');
                        break;
                }
            } else {
                instructionsPaiement.classList.remove('block');
                instructionsPaiement.classList.add('hidden');
            }
        });
        
        // Initialiser si une valeur est déjà sélectionnée
        if (methodePaiementSelect.value) {
            methodePaiementSelect.dispatchEvent(new Event('change'));
        }
    }
});
</script>
