{% extends 'base.html.twig' %}

{% block title %}Ajouter un article média - HAKI YETU asbl{% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 lg:px-8">
    <!-- En-tête -->
    <div class="mb-8">
        <a href="{{ path('app_relation_media') }}" class="inline-flex items-center text-sm font-semibold text-brand-700 hover:text-brand-800">
            <i class="fas fa-arrow-left mr-2"></i> Retour aux articles
        </a>
        <h1 class="mt-3 font-display text-4xl font-bold text-navy-900">Ajouter un article média</h1>
        <p class="mt-2 text-navy-700">
            Ajoutez un article de presse, reportage ou média parlant de HAKI YETU asbl.
        </p>
    </div>

    <!-- Formulaire -->
    <div class="rounded-xl border border-navy-200 bg-white p-8 shadow-lg">
        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
        
            <div class="grid gap-6 md:grid-cols-2">
                <!-- Titre -->
                <div class="col-span-2">
                    {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.titre, {'attr': {'class': 'modern-input'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <!-- Nom du média et Type -->
                <div>
                    {{ form_label(form.nomDeMedia, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nomDeMedia, {'attr': {'class': 'modern-input'}}) }}
                    {{ form_errors(form.nomDeMedia) }}
                </div>

                <div>
                    {{ form_label(form.typeMedia, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.typeMedia, {'attr': {'class': 'modern-input'}}) }}
                    {{ form_errors(form.typeMedia) }}
                </div>

                <!-- Date de publication et Logo -->
                <div>
                    {{ form_label(form.datePublication, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.datePublication, {'attr': {'class': 'modern-datepicker'}}) }}
                    {{ form_errors(form.datePublication) }}
                </div>

                <div>
                    {{ form_label(form.logoMedia, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.logoMedia, {'attr': {'class': 'modern-input'}}) }}
                    {{ form_errors(form.logoMedia) }}
                </div>

                <!-- Lien -->
                <div class="col-span-2">
                    {{ form_label(form.lien, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.lien, {'attr': {'class': 'modern-input'}}) }}
                    {{ form_errors(form.lien) }}
                </div>

                <!-- Description -->
                <div class="col-span-2">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'modern-textarea', 'rows': 5}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <!-- Actif -->
                <div class="col-span-2">
                    <div class="flex items-center gap-3">
                        {{ form_widget(form.actif, {'attr': {'class': 'modern-checkbox'}}) }}
                        {{ form_label(form.actif, null, {'label_attr': {'class': 'form-checkbox-label'}}) }}
                    </div>
                    {{ form_errors(form.actif) }}
                </div>
            </div>

            <!-- Boutons d'action -->
            <div class="flex gap-4 pt-6 border-t border-navy-100">
                <button type="submit" class="btn-primary">
                    <i class="fas fa-save mr-2"></i> Ajouter l'article
                </button>
                <a href="{{ path('app_relation_media') }}" class="btn-secondary">
                    <i class="fas fa-times mr-2"></i> Annuler
                </a>
            </div>

        {{ form_end(form) }}
    </div>

    <!-- Conseils -->
    <div class="mt-8 rounded-xl border border-brand-200 bg-brand-50 p-6">
        <div class="flex items-start gap-3">
            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-600 text-white">
                <i class="fas fa-lightbulb text-xs"></i>
            </div>
            <div>
                <h4 class="font-semibold text-navy-900">Conseils pour ajouter un article média</h4>
                <ul class="mt-2 space-y-2 text-sm text-navy-700">
                    <li>• <strong>Logo du média</strong> : Trouvez l'URL du logo officiel du média (format PNG ou SVG recommandé)</li>
                    <li>• <strong>Lien vers l'article</strong> : Assurez-vous que le lien est accessible et fonctionne</li>
                    <li>• <strong>Description</strong> : Ajoutez un résumé de l'article pour donner un aperçu aux visiteurs</li>
                    <li>• <strong>Type de média</strong> : Précisez s'il s'agit d'un journal, radio, télévision, site web, etc.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}