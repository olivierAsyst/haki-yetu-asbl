{% extends 'base.html.twig' %}

{% block title %}Contact — HAKI YETU asbl | Nous contacter à Uvira, Fizi et Mwenga{% endblock %}

{% block meta_description %}Contactez HAKI YETU asbl à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo). Téléphone : +243 994 116 041, Email : hakiyetuass@yahoo.fr. Questions, partenariats, orientations.{% endblock %}

{% block og_title %}Contact — HAKI YETU asbl | Nous contacter{% endblock %}
{% block og_description %}Contactez HAKI YETU asbl à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo). Téléphone : +243 994 116 041, Email : hakiyetuass@yahoo.fr.{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
        <p class="section-eyebrow">Contact</p>
        <h1 class="mt-2 font-display text-4xl font-semibold text-navy-900">Parlons-en</h1>
        <p class="prose-body mt-4">
            Une question, un partenariat, une orientation ? Écrivez-nous, notre équipe vous répondra dès que possible.
        </p>

        <div class="mt-10 grid gap-10 md:grid-cols-5">
            <div class="md:col-span-2 space-y-6">
                <div class="rounded-xl border border-brand-200 bg-white p-6">
                    <h2 class="font-display text-lg font-semibold text-navy-900">Siège social</h2>
                    <p class="mt-2 text-sm text-ink-900/70">
                        Économat Général du diocèse d'Uvira<br>
                        Qt Kimanga, Av du Congo, N°68<br>
                        Ville d'Uvira<br>
                        B.P. 18 Uvira, Sud-Kivu, RD Congo
                    </p>
                </div>
                <div class="rounded-xl border border-brand-200 bg-white p-6">
                    <h2 class="font-display text-lg font-semibold text-navy-900">Coordonnées</h2>
                    <ul class="mt-2 space-y-2 text-sm text-ink-900/70">
                        <li>Téléphone : <a class="text-brand-700 hover:underline" href="tel:+243994116041">+243 994 116 041</a></li>
                        <li>E-mail : <a class="text-brand-700 hover:underline" href="mailto:hakiyetuass@yahoo.fr">hakiyetuass@yahoo.fr</a></li>
                        <li>Facebook : Haki yetu asbl</li>
                    </ul>
                </div>
            </div>

            <div class="md:col-span-3">
                <div class="rounded-xl border border-brand-200 bg-white p-6 sm:p-8">
                    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'space-y-5'}}) }}
                        <div class="grid gap-5 sm:grid-cols-2">
                            <div>
                                {{ form_label(form.nom, null, {label_attr: {class: 'mb-1.5 block text-sm font-medium text-navy-900'}}) }}
                                {{ form_widget(form.nom) }}
                                {{ form_errors(form.nom) }}
                            </div>
                            <div>
                                {{ form_label(form.email, null, {label_attr: {class: 'mb-1.5 block text-sm font-medium text-navy-900'}}) }}
                                {{ form_widget(form.email) }}
                                {{ form_errors(form.email) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.sujet, null, {label_attr: {class: 'mb-1.5 block text-sm font-medium text-navy-900'}}) }}
                            {{ form_widget(form.sujet) }}
                            {{ form_errors(form.sujet) }}
                        </div>
                        <div>
                            {{ form_label(form.message, null, {label_attr: {class: 'mb-1.5 block text-sm font-medium text-navy-900'}}) }}
                            {{ form_widget(form.message) }}
                            {{ form_errors(form.message) }}
                        </div>
                        <button type="submit" class="btn-primary w-full sm:w-auto">Envoyer le message</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
