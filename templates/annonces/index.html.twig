{% extends 'base.html.twig' %}

{% block title %}Actualités — HAKI YETU asbl{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
            <p class="section-eyebrow">Autre actualités</p>
            <h1 class="mt-2 font-display text-4xl font-semibold text-navy-900">Actualités</h1>
            <p class="mt-4 max-w-2xl mx-auto text-lg text-ink-900/80">
                Restez informé des dernières nouvelles, événements et activités de HAKI YETU.
            </p>
        </div>

        <!-- Filtres améliorés -->
        <div class="mb-12 bg-white rounded-xl border border-brand-200 p-6 shadow-sm">
            <form method="get" class="grid gap-4 md:grid-cols-4">
                <div>
                    <label class="block text-sm font-medium text-navy-900 mb-2">Type d'actualité</label>
                    <select name="type" class="w-full rounded-lg border border-navy-300 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500 transition-colors">
                        <option value="">Tous les types</option>
                        {% for label, value in types %}
                            <option value="{{ value }}" {{ currentType == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-navy-900 mb-2">Recherche</label>
                    <input 
                        type="text" 
                        name="search" 
                        value="{{ search ?? '' }}"
                        placeholder="Rechercher..."
                        class="w-full rounded-lg border border-navy-300 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500 transition-colors"
                    >
                </div>
                
                <div class="flex flex-col">
                    <label class="block text-sm font-medium text-navy-900 mb-2">Trier par</label>
                    <select class="w-full rounded-lg border border-navy-300 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-brand-500 transition-colors">
                        <option>Plus récentes</option>
                        <option>Plus anciennes</option>
                        <option>Par importance</option>
                    </select>
                </div>
                
                <div class="flex items-end">
                    <button type="submit" class="w-full rounded-lg bg-brand-700 px-6 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 transition-colors shadow-sm hover:shadow">
                        <i class="fas fa-search mr-2"></i>Filtrer
                    </button>
                </div>
            </form>
        </div>

        {% if annonces|length > 0 %}
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {% for annonce in annonces %}
                    <article class="group bg-white rounded-xl border border-brand-200 overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                        <div class="p-6">
                            <div class="flex items-center justify-between mb-4">
                                <div class="inline-flex items-center rounded-full bg-brand-100 px-3 py-1 text-xs font-medium text-brand-800">
                                    {{ annonce.getTypeLabel() }}
                                </div>
                                {% if annonce.dateEvenement %}
                                    <time class="text-xs text-ink-900/60">
                                        {{ annonce.dateEvenement|date('d/m/Y') }}
                                    </time>
                                {% endif %}
                            </div>
                            
                            <h2 class="font-display text-lg font-semibold text-navy-900 mb-3 group-hover:text-brand-700 transition-colors">{{ annonce.titre }}</h2>
                            
                            {% if annonce.contenu %}
                                <p class="text-ink-900/70 mb-4 text-sm line-clamp-3 leading-relaxed">
                                    {{ annonce.contenu|slice(0, 150) }}...
                                </p>
                            {% endif %}
                            
                            <div class="flex items-center justify-between pt-4 border-t border-navy-100">
                                <a href="{{ path('app_annonces_show', {'id': annonce.id}) }}" class="inline-flex items-center text-brand-700 text-sm font-medium hover:text-brand-800">
                                    Lire la suite
                                    <i class="fas fa-arrow-right ml-1.5 text-xs"></i>
                                </a>
                                
                                {% if annonce.isExpired() %}
                                    <span class="inline-flex items-center gap-1 rounded-full bg-navy-100 px-2.5 py-1 text-xs font-medium text-navy-800">
                                        <i class="fas fa-clock"></i>
                                        Terminé
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>
            
            <div class="mt-12 flex justify-center">
                <nav class="inline-flex space-x-2" aria-label="Pagination">
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-brand-300 text-navy-700 hover:bg-brand-50 transition-colors">
                        <span class="sr-only">Précédent</span>
                        <i class="fas fa-chevron-left text-sm"></i>
                    </a>
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-brand-700 text-white font-semibold shadow-sm">
                        1
                    </a>
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-brand-300 text-navy-700 hover:bg-brand-50 transition-colors">
                        2
                    </a>
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-brand-300 text-navy-700 hover:bg-brand-50 transition-colors">
                        3
                    </a>
                    <a href="#" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-brand-300 text-navy-700 hover:bg-brand-50 transition-colors">
                        <span class="sr-only">Suivant</span>
                        <i class="fas fa-chevron-right text-sm"></i>
                    </a>
                </nav>
            </div>
        {% else %}
            <div class="text-center py-16">
                <div class="flex h-20 w-20 items-center justify-center rounded-full bg-brand-100 text-brand-700 mx-auto mb-6">
                    <i class="fas fa-newspaper text-3xl"></i>
                </div>
                <h3 class="font-display text-xl font-semibold text-navy-900 mb-3">Aucune actualité disponible</h3>
                <p class="text-ink-900/70 max-w-md mx-auto text-sm">
                    Aucune actualité n'est disponible pour le moment. Revenez bientôt pour découvrir nos dernières nouvelles.
                </p>
            </div>
        {% endif %}

        <div class="mt-16 rounded-xl bg-gradient-to-br from-navy-900 to-navy-800 p-8 text-white shadow-lg">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="font-display text-2xl font-semibold mb-6">Restez Informé</h2>
                <p class="text-brand-100/90 mb-8 text-sm leading-relaxed">
                    Abonnez-vous à notre newsletter pour recevoir directement dans votre boîte mail les dernières informations sur nos activités et événements.
                </p>
                
                <form class="max-w-md mx-auto">
                    <div class="flex gap-3">
                        <input 
                            type="email" 
                            placeholder="Votre adresse email" 
                            class="flex-1 rounded-lg border border-white/30 bg-white/10 px-4 py-3 text-white placeholder:text-white/50 focus:border-brand-400 focus:ring-brand-400 text-sm"
                            required
                        >
                        <button type="submit" class="rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700 transition-colors shadow-sm">
                            S'abonner
                        </button>
                    </div>
                    <p class="mt-3 text-xs text-brand-100/70">
                        En vous abonnant, vous acceptez de recevoir nos communications.
                    </p>
                </form>
            </div>
        </div>
    </section>
{% endblock %}