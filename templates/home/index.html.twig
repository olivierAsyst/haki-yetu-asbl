{% extends 'base.html.twig' %}

{% block title %}Accueil — HAKI YETU asbl | Association pour les personnes handicapées{% endblock %}

{% block meta_description %}HAKI YETU asbl : association de défense des droits des personnes vivant avec handicap à Uvira, Fizi et Mwenga. Formations professionnelles, accompagnement scolaire, coopératives, sensibilisation. Depuis 2011.{% endblock %}

{% block og_title %}Accueil — HAKI YETU asbl | Association pour les personnes handicapées{% endblock %}
{% block og_description %}HAKI YETU asbl : association de défense des droits des personnes vivant avec handicap à Uvira, Fizi et Mwenga. Formations professionnelles, accompagnement scolaire, coopératives, sensibilisation. Depuis 2011.{% endblock %}

{% block body %}

    <section class="relative overflow-hidden">
        <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-24 lg:px-8">
            <div>
                <p class="section-eyebrow">Association de défense des droits · Uvira, Sud-Kivu</p>
                <h1 class="mt-3 font-display text-4xl font-semibold leading-tight text-navy-900 sm:text-5xl">
                    Pour l'exclusion zéro des personnes vivant avec handicap.
                </h1>
                <p class="prose-body mt-6">
                    Depuis 2011, HAKI YETU accompagne les personnes vivant avec handicap d'Uvira,
                    Fizi et Mwenga dans leur diversité, vers une intégration participative et
                    effective aux instances de décision, aux actions de paix et de développement.
                </p>
                <div class="mt-8 flex flex-wrap gap-4">
                    <a href="{{ path('app_about') }}" class="btn-primary">Découvrir l'association</a>
                    <a href="{{ path('app_contact') }}" class="btn-secondary">Nous contacter</a>
                </div>
            </div>

            <div class="relative">
                <div class="aspect-[4/3] w-full rounded-2xl bg-navy-700 p-8 text-brand-50 shadow-lg">
                    <p class="font-display text-xl italic leading-snug text-white">
                        « Respect de la dignité humaine, l'intégrité, l'équité et la solidarité. »
                    </p>
                    <p class="mt-4 text-sm text-brand-100/80">— Valeurs de HAKI YETU asbl</p>
                    <div class="mt-8 flex items-center gap-4 border-t border-white/15 pt-6">
                        <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-4 border-brand-700 text-2xl font-display font-semibold">
                            ♿
                        </span>
                        <p class="text-sm text-brand-100/80">
                            Vision : exclusion zéro. Cible : personnes handicapées. Bénéficiaires :
                            personnes handicapées et autres personnes vulnérables.
                        </p>
                    </div>
                </div>
                <span class="absolute -bottom-5 -right-5 hidden rounded-xl bg-brand-700 px-5 py-3 font-display text-sm font-semibold text-white shadow-md sm:block">
                    Depuis mai 2011
                </span>
            </div>
        </div>
    </section>

    {% if annonces|length > 0 %}
        <section class="bg-navy-900 py-10 text-white" aria-labelledby="annonces-titre">
            <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                <h2 id="annonces-titre" class="font-display text-2xl font-semibold">À l'affiche</h2>
                <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                    {% for annonce in annonces %}
                        <article class="rounded-xl bg-white/5 p-5 ring-1 ring-white/10">
                            <span class="inline-block rounded-full bg-brand-700 px-3 py-1 text-xs font-semibold uppercase tracking-wide">
                                {{ annonce.typeLabel }}
                            </span>
                            <h3 class="mt-3 font-display text-lg font-semibold leading-snug">{{ annonce.titre }}</h3>
                            {% if annonce.dateEvenement %}
                                <p class="mt-1 text-sm text-brand-100/70">{{ annonce.dateEvenement|date('d/m/Y') }}</p>
                            {% endif %}
                            {% if annonce.contenu %}
                                <p class="mt-2 text-sm text-brand-100/80">{{ annonce.contenu|u.truncate(110, '…') }}</p>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="impact-titre">
        <p class="section-eyebrow">Nos réalisations</p>
        <h2 id="impact-titre" class="mt-2 font-display text-3xl font-semibold text-navy-900">Un impact mesuré sur le terrain</h2>

        <dl class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {% set stats = [
                {value: '450', label: "enfants vivant avec handicap accompagnés à l'école"},
                {value: '350', label: 'personnes formées en cordonnerie'},
                {value: '141', label: 'personnes en formation professionnelle (coupe et couture, saponification)'},
                {value: '90', label: 'personnes ayant reçu un micro-crédit'}
            ] %}
            {% for stat in stats %}
                <div class="rounded-xl border border-brand-200 bg-white p-6">
                    <dt class="sr-only">{{ stat.label }}</dt>
                    <dd>
                        <span class="font-display text-3xl font-semibold text-brand-700">{{ stat.value }}</span>
                        <p class="mt-2 text-sm text-ink-900/70">{{ stat.label }}</p>
                    </dd>
                </div>
            {% endfor %}
        </dl>
    </section>

    <section class="bg-brand-50 py-16" aria-labelledby="secteurs-titre">
        <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <p class="section-eyebrow">Secteurs d'intervention</p>
            <h2 id="secteurs-titre" class="mt-2 font-display text-3xl font-semibold text-navy-900">Où nous agissons</h2>

            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for secteur in [
                    "Droits humains et gouvernance inclusive",
                    "Éducation inclusive",
                    "Santé, droit sexuel et reproductif",
                    "Renforcement des capacités intégrant l'approche genre",
                    "Sports paralympiques et loisirs",
                    "Urgence et aides humanitaires",
                    "Protection de l'enfance en situation de handicap"
                ] %}
                    <li class="flex items-start gap-3 rounded-lg bg-white p-4 ring-1 ring-brand-200">
                        <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand-700"></span>
                        <span class="text-sm text-ink-900/80">{{ secteur }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </section>

    {% if activites|length > 0 %}
        <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="activites-titre">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="section-eyebrow">Actualité</p>
                    <h2 id="activites-titre" class="mt-2 font-display text-3xl font-semibold text-navy-900">Activités récentes</h2>
                </div>
                <a href="{{ path('app_activites') }}" class="text-sm font-semibold text-brand-700 hover:text-brand-800">
                    Voir toutes les activités →
                </a>
            </div>

            <div class="mt-8 grid gap-6 md:grid-cols-3">
                {% for activite in activites %}
                    <a href="{{ path('app_activites_show', {slug: activite.slug}) }}" class="group block overflow-hidden rounded-xl bg-white ring-1 ring-brand-200 transition hover:shadow-md">
                        {% if activite.imageName %}
                            <img src="{{ vich_uploader_asset(activite, 'imageFile')|imagine_filter('thumbnail') }}" alt="" loading="lazy" class="h-44 w-full object-cover transition duration-300 group-hover:scale-105">
                        {% else %}
                            <div class="flex h-44 w-full items-center justify-center bg-navy-50 text-navy-600">
                                <span class="font-display text-sm">HAKI YETU</span>
                            </div>
                        {% endif %}
                        <div class="p-5">
                            <h3 class="font-display text-lg font-semibold text-navy-900 group-hover:text-brand-700">{{ activite.titre }}</h3>
                            {% if activite.date %}
                                <p class="mt-1 text-xs font-medium uppercase tracking-wide text-brand-700">{{ activite.date|date('d/m/Y') }}</p>
                            {% endif %}
                            {% if activite.description %}
                                <p class="mt-2 text-sm text-ink-900/70">{{ activite.description|u.truncate(100, '…') }}</p>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if albums|length > 0 %}
        <section class="bg-brand-50 py-16" aria-labelledby="galerie-titre">
            <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="section-eyebrow">En images</p>
                        <h2 id="galerie-titre" class="mt-2 font-display text-3xl font-semibold text-navy-900">Galerie</h2>
                    </div>
                    <a href="{{ path('app_galerie') }}" class="text-sm font-semibold text-brand-700 hover:text-brand-800">
                        Voir tous les albums →
                    </a>
                </div>

                <div class="mt-8 grid gap-6 sm:grid-cols-2 md:grid-cols-3">
                    {% for album in albums %}
                        <a href="{{ path('app_galerie_show', {id: album.id}) }}" class="group block overflow-hidden rounded-xl bg-white ring-1 ring-brand-200">
                            {% set cover = album.coverImage %}
                            {% if cover %}
                                <img src="{{ vich_uploader_asset(cover, 'imageFile') }}" alt="" loading="lazy" class="h-48 w-full object-cover transition duration-300 group-hover:scale-105">
                            {% else %}
                                <div class="flex h-48 w-full items-center justify-center bg-navy-50 text-navy-600">
                                    <span class="font-display text-sm">Album photo</span>
                                </div>
                            {% endif %}
                            <div class="p-4">
                                <h3 class="font-display font-semibold text-navy-900">{{ album.titre }}</h3>
                                <p class="mt-1 text-xs text-ink-900/60">{{ album.images|length }} photo(s)</p>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8" aria-labelledby="partenaires-titre">
        <p class="section-eyebrow">Ils nous soutiennent</p>
        <h2 id="partenaires-titre" class="mt-2 font-display text-3xl font-semibold text-navy-900">Nos partenaires</h2>
        <ul class="mt-8 flex flex-wrap gap-x-10 gap-y-4 text-sm font-semibold text-navy-700">
            {% for partenaire in ['Fondation ABILIS', 'MIVA Suisse', 'Aide fraternelle salvatorienne', 'Handicap International', "Mairie de la ville d'Uvira", 'Conférence Épiscopale Italienne'] %}
                <li class="rounded-lg border border-brand-200 bg-white px-4 py-2">{{ partenaire }}</li>
            {% endfor %}
        </ul>
    </section>

{% endblock %}
