{% extends 'base.html.twig' %}

{% block title %}Accueil — HAKI YETU asbl | Association pour les personnes handicapées{% endblock %}

{% block meta_description %}HAKI YETU asbl : association de défense des droits des personnes vivant avec handicap à Uvira, Fizi et Mwenga. Formations professionnelles, accompagnement scolaire, coopératives, sensibilisation. Depuis 2011.{% endblock %}

{% block og_title %}Accueil — HAKI YETU asbl | Association pour les personnes handicapées{% endblock %}
{% block og_description %}HAKI YETU asbl : association de défense des droits des personnes vivant avec handicap à Uvira, Fizi et Mwenga. Formations professionnelles, accompagnement scolaire, coopératives, sensibilisation. Depuis 2011.{% endblock %}

{% block body %}

    <section class="relative overflow-hidden humanitarian-header pattern-humanitarian">
        <div class="absolute inset-0 bg-pattern opacity-30"></div>
        <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 md:items-center md:py-28 lg:px-8">
            <div class="animate-fade-in-up">
                <p class="section-eyebrow text-brand-100/80">Association de défense des droits · Uvira, Sud-Kivu</p>
                <h1 class="mt-4 font-display text-5xl font-bold leading-tight text-white sm:text-6xl lg:text-7xl">
                    Pour l'<span class="bg-gradient-to-r from-brand-400 to-brand-300 bg-clip-text text-transparent">exclusion zéro</span> des personnes vivant avec handicap.
                </h1>
                <p class="mt-8 text-lg leading-relaxed text-brand-100/90 max-w-2xl">
                    Depuis 2011, HAKI YETU accompagne les personnes vivant avec handicap d'Uvira,
                    Fizi et Mwenga dans leur diversité, vers une intégration participative et
                    effective aux instances de décision, aux actions de paix et de développement.
                </p>
                <div class="mt-10 flex flex-wrap gap-6">
                    <a href="{{ path('app_about') }}" class="btn-humanitarian">
                        <i class="fas fa-arrow-right"></i> Découvrir notre mission
                    </a>
                    <a href="{{ path('app_don') }}" class="btn-humanitarian-secondary">
                        <i class="fas fa-heart"></i> Soutenir notre action
                    </a>
                </div>
            </div>

            <div class="relative animate-fade-in">
                <div class="card-gradient aspect-[4/3] w-full p-8 text-brand-50 shadow-2xl">
                    <div class="relative z-10">
                        <p class="font-display text-2xl italic leading-snug text-white">
                            « Respect de la dignité humaine, l'intégrité, l'équité et la solidarité. »
                        </p>
                        <p class="mt-4 text-sm text-brand-100/90">— Valeurs de HAKI YETU asbl</p>
                        <div class="mt-8 flex items-center gap-4 border-t border-white/20 pt-6">
                            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full border-4 border-brand-700 bg-brand-800 text-3xl font-display font-semibold shadow-lg">
                                ♿
                            </span>
                            <p class="text-sm text-brand-100/90 leading-relaxed">
                                <strong>Vision :</strong> exclusion zéro.<br>
                                <strong>Cible :</strong> personnes handicapées.<br>
                                <strong>Bénéficiaires :</strong> personnes handicapées et autres personnes vulnérables.
                            </p>
                        </div>
                    </div>
                </div>
                <span class="absolute -bottom-5 -right-5 hidden rounded-xl bg-gradient-to-r from-brand-700 to-brand-800 px-6 py-4 font-display text-sm font-semibold text-white shadow-xl animate-fade-in sm:block">
                    <i class="fas fa-calendar-alt mr-2"></i> Depuis mai 2011
                </span>
            </div>
        </div>
    </section>

    {% if annonces|length > 0 %}
        <section class="bg-gradient-to-r from-navy-800 to-navy-900 py-12 text-white" aria-labelledby="annonces-titre">
            <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                <div class="flex items-center gap-3">
                    <span class="text-3xl text-brand-400"><i class="fas fa-bullhorn"></i></span>
                    <h2 id="annonces-titre" class="font-display text-3xl font-bold">À l'affiche</h2>
                </div>
                <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
                    {% for annonce in annonces %}
                        <article class="card-modern bg-white/10 backdrop-blur-sm p-6 ring-1 ring-white/20 transition-all duration-300 hover:bg-white/20">
                            <span class="badge-modern badge-primary mb-3">
                                {{ annonce.typeLabel }}
                            </span>
                            <h3 class="font-display text-lg font-bold leading-snug text-white">{{ annonce.titre }}</h3>
                            {% if annonce.dateEvenement %}
                                <p class="mt-2 text-sm text-brand-100/90">
                                    <i class="fas fa-calendar-alt opacity-75 mr-2"></i> {{ annonce.dateEvenement|date('d/m/Y') }}
                                </p>
                            {% endif %}
                            {% if annonce.contenu %}
                                <p class="mt-3 text-sm text-brand-100/80 leading-relaxed">{{ annonce.contenu|u.truncate(110, '…') }}</p>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <!-- Section urgences humanitaires -->
    {% if urgences_urgentes|length > 0 %}
        <section class="relative overflow-hidden bg-gradient-to-r from-red-600 to-orange-600 text-white" aria-labelledby="urgences-titre">
            <div class="absolute inset-0 pattern-emergency opacity-10"></div>
            <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
                <div class="text-center mb-12">
                    <div class="flex items-center justify-center gap-3 mb-4">
                        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm">
                            <i class="fas fa-exclamation-triangle text-xl"></i>
                        </span>
                        <h2 id="urgences-titre" class="font-display text-4xl font-bold sm:text-5xl">Urgences humanitaires</h2>
                    </div>
                    <p class="mx-auto mt-4 max-w-3xl text-lg opacity-90">
                        Des situations critiques où votre soutien fait immédiatement la différence pour les personnes handicapées en situation d'urgence.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {% for urgence in urgences_urgentes|slice(0, 3) %}
                        <div class="emergency-card bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-6 hover:bg-white/20 transition-all duration-300">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-xs font-semibold uppercase tracking-wide bg-white/20 px-3 py-1 rounded-full">
                                    {{ urgence.type|replace({'_': ' '})|title }}
                                </span>
                                <span class="text-xs px-2 py-1 rounded-full bg-yellow-100 text-yellow-800">
                                    <i class="fas fa-clock mr-1"></i>{{ urgence.getJoursRestants ?? '∞' }} jours
                                </span>
                            </div>
                            
                            <h3 class="font-display text-xl font-bold mb-3">{{ urgence.titre }}</h3>
                            
                            <div class="mb-4">
                                <div class="flex items-center gap-2 text-sm opacity-80 mb-1">
                                    <i class="fas fa-map-marker-alt"></i>
                                    {{ urgence.lieu }}
                                </div>
                                <p class="text-sm opacity-90 line-clamp-2">{{ urgence.description|slice(0, 100) }}...</p>
                            </div>
                            
                            <!-- Progression -->
                            <div class="mb-6">
                                <div class="flex justify-between text-sm font-medium mb-1">
                                    <span>{{ urgence.getPourcentageCollecte }}% atteint</span>
                                    <span>{{ urgence.montantCollecte|number_format(0, ',', ' ') }} CDF</span>
                                </div>
                                <div class="h-2 overflow-hidden rounded-full bg-white/20">
                                    <div class="h-full bg-gradient-to-r from-yellow-400 to-orange-400 rounded-full transition-all duration-500" 
                                         style="width: {{ urgence.getPourcentageCollecte }}%"></div>
                                </div>
                                <div class="text-xs opacity-70 mt-1 text-right">
                                    Objectif : {{ urgence.montantCible|number_format(0, ',', ' ') }} CDF
                                </div>
                            </div>
                            
                            <div class="flex gap-3">
                                <a href="{{ path('app_urgence_don', {'id': urgence.id}) }}" 
                                   class="flex-1 btn-humanitarian bg-white text-red-600 hover:bg-red-50 text-center py-2 text-sm">
                                    <i class="fas fa-heart mr-1"></i>Soutenir
                                </a>
                                <a href="{{ path('app_urgence_show', {'id': urgence.id}) }}" 
                                   class="flex-1 btn-humanitarian-secondary border-white/30 text-white hover:bg-white/10 text-center py-2 text-sm">
                                    <i class="fas fa-info-circle mr-1"></i>Détails
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                
                <div class="mt-12 text-center">
                    <a href="{{ path('app_urgence_index') }}" class="btn-humanitarian bg-white text-red-600 hover:bg-red-50 px-8 py-3">
                        <i class="fas fa-exclamation-triangle mr-2"></i>Voir toutes les urgences
                    </a>
                    <p class="mt-4 text-sm opacity-80">
                        {% set total_collecte = 0 %}
                        {% set total_cible = 0 %}
                        {% for urgence in urgences_urgentes %}
                            {% set total_collecte = total_collecte + urgence.montantCollecte %}
                            {% set total_cible = total_cible + urgence.montantCible %}
                        {% endfor %}
                        <strong>{{ urgences_urgentes|length }} urgences actives</strong> · 
                        {{ total_collecte|number_format(0, ',', ' ') }} CDF collectés sur {{ total_cible|number_format(0, ',', ' ') }} CDF cibles
                    </p>
                </div>
            </div>
        </section>
    {% endif %}

    <section class="humanitarian-section mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8" aria-labelledby="impact-titre">
        <div class="text-center">
            <p class="section-eyebrow">Impact & réalisations</p>
            <h2 id="impact-titre" class="mt-4 font-display text-4xl font-bold text-navy-900 md:text-5xl">Notre impact mesuré sur le terrain</h2>
            <p class="mt-6 max-w-3xl mx-auto prose-body text-lg">
                Des chiffres qui témoignent de notre engagement quotidien pour l'inclusion et le développement.
            </p>
        </div>

        <dl class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {% set stats = [
                {value: '450', label: "enfants vivant avec handicap accompagnés à l'école", icon: 'fas fa-graduation-cap'},
                {value: '350', label: 'personnes formées en cordonnerie', icon: 'fas fa-tools'},
                {value: '141', label: 'personnes en formation professionnelle (coupe et couture, saponification)', icon: 'fas fa-award'},
                {value: '90', label: 'personnes ayant reçu un micro-crédit', icon: 'fas fa-hand-holding-usd'}
            ] %}
            {% for stat in stats %}
                <div class="impact-card text-center p-8">
                    <dt class="sr-only">{{ stat.label }}</dt>
                    <dd>
                        <div class="humanitarian-icon mx-auto">
                            <i class="{{ stat.icon }} text-2xl"></i>
                        </div>
                        <span class="impact-number">{{ stat.value }}+</span>
                        <p class="impact-label">{{ stat.label }}</p>
                    </dd>
                </div>
            {% endfor %}
        </dl>
    </section>

    <section class="bg-gradient-to-br from-brand-50/50 to-navy-50/50 py-24 pattern-humanitarian" aria-labelledby="secteurs-titre">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="text-center">
                <p class="section-eyebrow">Domaines d'action</p>
                <h2 id="secteurs-titre" class="mt-4 font-display text-4xl font-bold text-navy-900 md:text-5xl">Nos secteurs d'intervention</h2>
                <p class="mt-6 max-w-3xl mx-auto prose-body text-lg">
                    Une approche holistique pour accompagner les personnes vivant avec handicap dans tous les aspects de leur vie.
                </p>
            </div>

            <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {% for secteur in [
                    {label: "Droits humains et gouvernance inclusive", icon: "fas fa-balance-scale", color: "from-brand-600 to-brand-800"},
                    {label: "Éducation inclusive", icon: "fas fa-book-reader", color: "from-navy-600 to-navy-800"},
                    {label: "Santé, droit sexuel et reproductif", icon: "fas fa-heartbeat", color: "from-sage-600 to-sage-800"},
                    {label: "Renforcement des capacités intégrant l'approche genre", icon: "fas fa-users", color: "from-brand-600 to-brand-800"},
                    {label: "Sports paralympiques et loisirs", icon: "fas fa-trophy", color: "from-navy-600 to-navy-800"},
                    {label: "Urgence et aides humanitaires", icon: "fas fa-first-aid", color: "from-sage-600 to-sage-800"},
                    {label: "Protection de l'enfance en situation de handicap", icon: "fas fa-child", color: "from-brand-600 to-brand-800"}
                ] %}
                    <div class="impact-card p-8">
                        <div class="flex items-start gap-6">
                            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br {{ secteur.color }} text-white shadow-lg">
                                <i class="{{ secteur.icon }} text-xl"></i>
                            </div>
                            <div>
                                <h3 class="font-display text-xl font-bold text-navy-900 mb-2">{{ secteur.label }}</h3>
                                <p class="text-sm text-navy-600 leading-relaxed">
                                    {% if secteur.label == "Droits humains et gouvernance inclusive" %}
                                        Plaidoyer pour l'égalité des droits et la participation aux instances de décision.
                                    {% elseif secteur.label == "Éducation inclusive" %}
                                        Accès à l'éducation pour tous les enfants, sans discrimination.
                                    {% elseif secteur.label == "Santé, droit sexuel et reproductif" %}
                                        Accès aux soins de santé et information sur les droits sexuels.
                                    {% elseif secteur.label == "Renforcement des capacités intégrant l'approche genre" %}
                                        Formations professionnelles et autonomisation économique.
                                    {% elseif secteur.label == "Sports paralympiques et loisirs" %}
                                        Inclusion par le sport et les activités récréatives.
                                    {% elseif secteur.label == "Urgence et aides humanitaires" %}
                                        Soutien aux personnes vulnérables en situation de crise.
                                    {% else %}
                                        Protection et accompagnement des enfants en situation de handicap.
                                    {% endif %}
                                </p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Témoignage inspirant -->
    <section class="humanitarian-section mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <p class="section-eyebrow">Témoignages</p>
            <h2 class="mt-4 font-display text-4xl font-bold text-navy-900 md:text-5xl">Des vies transformées</h2>
            <p class="mt-6 max-w-3xl mx-auto prose-body text-lg">
                Découvrez comment notre action fait la différence dans la vie des personnes que nous accompagnons.
            </p>
        </div>

        <div class="grid gap-8 lg:grid-cols-2">
            <div class="testimonial-card">
                <div class="humanitarian-icon">
                    <i class="fas fa-user-graduate text-2xl"></i>
                </div>
                <blockquote>
                    <p class="humanitarian-quote">
                        "Grâce à la formation en cordonnerie de HAKI YETU, j'ai pu ouvrir mon propre atelier. 
                        Aujourd'hui, je suis autonome et je forme à mon tour d'autres personnes handicapées."
                    </p>
                    <footer class="quote-author">
                        <strong>Jean, 32 ans</strong><br>
                        <span class="text-navy-600">Ancien bénéficiaire, aujourd'hui formateur</span>
                    </footer>
                </blockquote>
            </div>

            <div class="testimonial-card">
                <div class="humanitarian-icon">
                    <i class="fas fa-child text-2xl"></i>
                </div>
                <blockquote>
                    <p class="humanitarian-quote">
                        "Mon fils, qui est sourd, peut enfin aller à l'école comme les autres enfants. 
                        Les enseignants ont été formés et il a maintenant des amis. Merci HAKI YETU !"
                    </p>
                    <footer class="quote-author">
                        <strong>Marie, mère de famille</strong><br>
                        <span class="text-navy-600">Maman d'un enfant bénéficiant du programme éducation inclusive</span>
                    </footer>
                </blockquote>
            </div>
        </div>

        <div class="mt-12 text-center">
            <a href="{{ path('app_activites') }}" class="btn-humanitarian">
                <i class="fas fa-running mr-2"></i> Découvrir plus d'histoires
            </a>
        </div>
    </section>

    {% if activites|length > 0 %}
        <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8" aria-labelledby="activites-titre">
            <div class="flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="section-eyebrow">Actualité</p>
                    <h2 id="activites-titre" class="mt-2 font-display text-4xl font-bold text-navy-900">Activités récentes</h2>
                </div>
                <a href="{{ path('app_activites') }}" class="btn-tertiary">
                    Voir toutes les activités →
                </a>
            </div>

            <div class="mt-10 grid gap-8 md:grid-cols-3">
                {% for activite in activites %}
                    <a href="{{ path('app_activites_show', {slug: activite.slug}) }}" class="card-modern group block overflow-hidden">
                        <div class="image-overlay">
                            {% if activite.imageName %}
                                <img src="{{ vich_uploader_asset(activite, 'imageFile')|imagine_filter('thumbnail') }}" alt="" loading="lazy" class="h-48 w-full object-cover transition duration-500 group-hover:scale-110">
                            {% else %}
                                <div class="flex h-48 w-full items-center justify-center bg-gradient-to-br from-navy-50 to-navy-100 text-navy-600">
                                    <span class="font-display text-lg font-semibold">HAKI YETU</span>
                                </div>
                            {% endif %}
                        </div>
                        <div class="p-6">
                            <h3 class="font-display text-xl font-bold text-navy-900 group-hover:text-brand-700 transition-colors">{{ activite.titre }}</h3>
                            {% if activite.date %}
                                <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-brand-700">
                                    <i class="fas fa-calendar-alt opacity-75 mr-2"></i> {{ activite.date|date('d/m/Y') }}
                                </p>
                            {% endif %}
                            {% if activite.description %}
                                <p class="mt-3 text-sm text-ink-900/70 leading-relaxed">{{ activite.description|u.truncate(100, '…') }}</p>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if albums|length > 0 %}
        <section class="bg-gradient-to-br from-navy-50 to-brand-50 py-20" aria-labelledby="galerie-titre">
            <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
                <div class="flex flex-wrap items-end justify-between gap-4">
                    <div>
                        <p class="section-eyebrow">En images</p>
                        <h2 id="galerie-titre" class="mt-2 font-display text-4xl font-bold text-navy-900">Galerie</h2>
                    </div>
                    <a href="{{ path('app_galerie') }}" class="btn-tertiary">
                        Voir tous les albums →
                    </a>
                </div>

                <div class="mt-10 grid gap-8 sm:grid-cols-2 md:grid-cols-3">
                    {% for album in albums %}
                        <a href="{{ path('app_galerie_show', {id: album.id}) }}" class="card-modern group block overflow-hidden">
                            <div class="image-overlay">
                                {% set cover = album.coverImage %}
                                {% if cover %}
                                    <img src="{{ vich_uploader_asset(cover, 'imageFile')|imagine_filter('medium') }}" alt="" loading="lazy" class="h-56 w-full object-cover transition duration-500 group-hover:scale-110">
                                {% else %}
                                    <div class="flex h-56 w-full items-center justify-center bg-gradient-to-br from-navy-50 to-navy-100 text-navy-600">
                                        <span class="font-display text-lg font-semibold">Album photo</span>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="p-6">
                                <h3 class="font-display text-xl font-bold text-navy-900 group-hover:text-brand-700 transition-colors">{{ album.titre }}</h3>
                                <p class="mt-2 text-sm text-ink-900/60">
                                    <i class="fas fa-images opacity-75 mr-2"></i> {{ album.images|length }} photo(s)
                                </p>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8" aria-labelledby="partenaires-titre">
        <div class="text-center">
            <p class="section-eyebrow">Ils nous soutiennent</p>
            <h2 id="partenaires-titre" class="mt-2 font-display text-4xl font-bold text-navy-900">Nos partenaires</h2>
        </div>
        
        {% if partenaires is empty %}
            <p class="mt-8 text-center text-navy-600">
                Nos partenaires seront bientôt affichés ici.
            </p>
        {% else %}
            <div class="mt-12">
                <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                    {% for partenaire in partenaires|slice(0, 6) %}
                        <div class="card-modern p-6 text-center">
                            <div class="mb-6 flex justify-center">
                                {% if partenaire.logoName %}
                                    <div class="flex h-24 w-full items-center justify-center rounded-xl bg-white p-4">
                                        <img 
                                            src="{{ asset('/uploads/partenaires/' ~ partenaire.logoName) }}" 
                                            alt="Logo {{ partenaire.nom }}"
                                            class="max-h-20 max-w-full object-contain"
                                            loading="lazy"
                                        >
                                    </div>
                                {% else %}
                                    <div class="flex h-24 w-full items-center justify-center rounded-xl bg-navy-100 text-navy-700">
                                        <i class="fas fa-handshake text-4xl"></i>
                                    </div>
                                {% endif %}
                            </div>
                            
                            <h3 class="font-display text-lg font-bold text-navy-900">{{ partenaire.nom }}</h3>
                            
                            {% if partenaire.description %}
                                <p class="mt-3 text-sm text-navy-600 line-clamp-3">{{ partenaire.description|u.truncate(120, '...') }}</p>
                            {% endif %}
                            
                            {% if partenaire.url %}
                                <a href="{{ partenaire.url }}" target="_blank" rel="noopener" class="mt-4 inline-flex items-center text-sm text-brand-700 hover:text-brand-800">
                                    <i class="fas fa-external-link-alt mr-2"></i> Visiter le site
                                </a>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                
                {% if partenaires|length > 6 %}
                    <div class="mt-8 text-center">
                        <a href="{{ path('app_partenaires') }}" class="btn-tertiary">
                            <i class="fas fa-handshake mr-2"></i> Voir tous nos partenaires
                        </a>
                    </div>
                {% endif %}
            </div>
        {% endif %}
        
        <div class="mt-12 text-center">
            <p class="text-sm text-navy-600">
                Vous souhaitez devenir partenaire ? 
                <a href="{{ path('app_partenaires') }}" class="text-brand-700 hover:text-brand-800">Découvrez comment nous soutenir</a>
            </p>
        </div>
    </section>

{% endblock %}
