{% extends 'base.html.twig' %}

{% block title %}{{ activite.titre }} — HAKI YETU asbl | Activité{% endblock %}

{% block meta_description %}{{ activite.description ? activite.description|u.truncate(160, '...') : 'Activité de HAKI YETU asbl à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo).' }}{% endblock %}

{% block og_title %}{{ activite.titre }} — HAKI YETU asbl{% endblock %}
{% block og_description %}{{ activite.description ? activite.description|u.truncate(160, '...') : 'Activité de HAKI YETU asbl à Uvira, Fizi et Mwenga (Sud-Kivu, RD Congo).' }}{% endblock %}

{% block body %}
    <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
        <nav class="mb-8">
            <a href="{{ path('app_activites') }}" class="text-sm font-semibold text-brand-700 hover:text-brand-800">
                ← Retour aux activités
            </a>
        </nav>

        <article>
            <header class="mb-8">
                <p class="section-eyebrow">Activité</p>
                <h1 class="mt-2 font-display text-4xl font-semibold text-navy-900">{{ activite.titre }}</h1>
                {% if activite.date %}
                    <p class="mt-2 text-sm font-medium uppercase tracking-wide text-brand-700">{{ activite.date|date('d/m/Y') }}</p>
                {% endif %}
            </header>

            {% if activite.imageName %}
                <div class="mb-8 overflow-hidden rounded-xl">
                    <img src="{{ vich_uploader_asset(activite, 'imageFile')|imagine_filter('large') }}" alt="{{ activite.titre }}" class="h-auto w-full object-cover">
                </div>
            {% endif %}

            <div class="prose-body max-w-none">
                {% if activite.description %}
                    <p class="text-lg leading-relaxed text-ink-900/80">{{ activite.description|nl2br }}</p>
                {% endif %}
            </div>
        </article>
    </section>
{% endblock %}
